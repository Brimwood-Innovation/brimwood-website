drafts/

# Deployment artifacts — built from build/, not versioned
*.zip

# Local environment and secrets
.env
.env.*
secrets/
*.pem
*.key

# Editor / OS noise
.DS_Store
.vscode/
*.log

# Monorepo tooling (added T1)
node_modules/
# NOTE: package-lock.json files ARE committed (reproducible CI builds).
