---
/* Breadcrumbs (redesign T9, spec 4.4). Renders the visible trail that
 * the page's BreadcrumbList JSON-LD mirrors. The last item is the
 * current page and carries aria-current. */
interface Crumb {
  name: string;
  path?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {item.path && i < items.length - 1 ? (
          <a href={item.path}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
