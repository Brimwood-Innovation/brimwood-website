---
// HeroDots (T8): the v7 living dot-grid as a client-side island.
// Vanilla JS, no framework runtime. Astro bundles component scripts as
// deferred modules, so this never blocks first paint; the canvas is
// absolutely positioned and pointer-transparent, so no layout shift.
// prefers-reduced-motion -> the engine draws one static frame.
---
<canvas class="dots" id="dotgrid" aria-hidden="true"></canvas>
<script>

// --- living dots v7: vortex + fireflies + secret life + words + trails + summon ---
(function(){
  var cv = document.getElementById('dotgrid');
  if(!cv) return;
  var ctx = cv.getContext('2d');
  var GAP = 46, R = 3, MAXA = 96;
  var dots = [], actors = [], W = 0, H = 0, dpr = 1, CX = 0, CY = 0;
  var mx = -9999, my = -9999, smx = -9999, smy = -9999;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var t0 = performance.now(), nowT = 0;
  var ripples = [];
  var summon = {until:-1, x:0, y:0, shape:'heart', pts:[]};
  // evolving wave field: retunes itself every ~20s so the pattern never repeats
  var field = {wl:90, sp:1.1, tang:14, rad:9, rot:0, rotSp:0.05,
               tWl:90, tSp:1.1, tTang:14, tRad:9, tRotSp:0.05, next:14};
  var lastCyc = -1;

  // ---------- director ----------
  var SCENES = [
    {n:'drift', d:7}, {n:'gather', d:6}, {n:'shape', d:13}, {n:'word', d:12},
    {n:'divide', d:6}, {n:'fight', d:7}, {n:'army', d:9}, {n:'release', d:5}
  ];
  var TOTAL = 0, si;
  for(si = 0; si < SCENES.length; si++) TOTAL += SCENES[si].d;
  var dir = {idx:-1, P:{x:0,y:0}, Q:{x:0,y:0}, shape:'atom', pts:[], S:130,
             word:'BUILD', wpts:[], wS:14, wcount:0};

  // ---------- 5x7 pixel font (letters needed for BUILD / DREAM / BRIMWOOD) ----------
  var FONT = {
    A:['.###.','#...#','#...#','#####','#...#','#...#','#...#'],
    B:['####.','#...#','#...#','####.','#...#','#...#','####.'],
    D:['####.','#...#','#...#','#...#','#...#','#...#','####.'],
    E:['#####','#....','#....','####.','#....','#....','#####'],
    I:['#####','..#..','..#..','..#..','..#..','..#..','#####'],
    L:['#....','#....','#....','#....','#....','#....','#####'],
    M:['#...#','##.##','#.#.#','#.#.#','#...#','#...#','#...#'],
    O:['.###.','#...#','#...#','#...#','#...#','#...#','.###.'],
    R:['####.','#...#','#...#','####.','#.#..','#..#.','#...#'],
    U:['#...#','#...#','#...#','#...#','#...#','#...#','.###.'],
    W:['#...#','#...#','#...#','#.#.#','#.#.#','##.##','#...#']
  };
  function wordPoints(word){
    var pts = [], li, r, c, g = [];
    for(li = 0; li < word.length; li++) g.push(FONT[word[li]]);
    var widths = word.length * 6 - 1;
    for(li = 0; li < g.length; li++)
      for(r = 0; r < 7; r++)
        for(c = 0; c < 5; c++)
          if(g[li][r][c] === '#') pts.push({x:(li * 6 + c) - widths / 2, y:r - 3});
    return {pts:pts, widths:widths};
  }

  // ---------- shape templates (unit coords ~[-1,1]) ----------
  function shapePoints(kind){
    var P = [], i, k, u, a, th;
    function pt(x, y, w){ P.push({x:x, y:y, w:w||0}); }
    if(kind === 'bird'){
      for(i = 0; i < 16; i++){ u = -1 + 2 * i / 15; pt(u, 0.42 * Math.abs(u) - 0.28, Math.abs(u) > 0.15 ? (u < 0 ? -1 : 1) : 0); }
      pt(-0.06, 0.02, 0); pt(0.06, 0.02, 0); pt(0, 0.14, 0);
    } else if(kind === 'butterfly'){
      for(k = 0; k < 7; k++){ a = k / 7 * Math.PI * 2; pt(-0.42 + Math.cos(a) * 0.34, -0.3 + Math.sin(a) * 0.44, -1); }
      for(k = 0; k < 7; k++){ a = k / 7 * Math.PI * 2; pt(0.42 + Math.cos(a) * 0.34, -0.3 + Math.sin(a) * 0.44, 1); }
      for(k = 0; k < 5; k++){ a = k / 5 * Math.PI * 2; pt(-0.36 + Math.cos(a) * 0.26, 0.36 + Math.sin(a) * 0.32, -1); }
      for(k = 0; k < 5; k++){ a = k / 5 * Math.PI * 2; pt(0.36 + Math.cos(a) * 0.26, 0.36 + Math.sin(a) * 0.32, 1); }
      for(i = 0; i < 4; i++){ pt(0, -0.5 + i * 0.33, 0); }
    } else if(kind === 'fish'){
      for(k = 0; k < 10; k++){ a = k / 10 * Math.PI * 2; pt(Math.cos(a) * 0.68, Math.sin(a) * 0.34, 0); }
      pt(0.68, 0, 0); pt(0.98, -0.3, 0); pt(0.98, 0.3, 0); pt(0.83, 0, 0);
      pt(-0.42, -0.06, 0);
    } else if(kind === 'tree'){
      for(i = 0; i < 4; i++){ pt(0, 0.25 + i * 0.22, 0); }
      for(k = 0; k < 12; k++){ a = k / 12 * Math.PI * 2; pt(Math.cos(a) * 0.55, -0.28 + Math.sin(a) * 0.5, 0); }
      pt(0, -0.28, 0); pt(-0.2, -0.3, 0); pt(0.2, -0.3, 0);
    } else if(kind === 'book'){
      for(i = 0; i <= 4; i++){ u = -0.62 + 1.24 * i / 4; pt(u, -0.45, 0); pt(u, 0.45, 0); }
      for(i = 1; i < 4; i++){ u = -0.45 + 0.9 * i / 3; pt(-0.62, u, 0); pt(0.62, u, 0); }
      for(i = 0; i < 4; i++){ pt(0, -0.34 + i * 0.23, 0); }
    } else if(kind === 'brain'){
      for(k = 0; k < 12; k++){ a = k / 12 * Math.PI * 2; pt(Math.cos(a) * (0.68 + 0.06 * Math.sin(a * 3)), Math.sin(a) * (0.62 + 0.06 * Math.cos(a * 2)), 0); }
      for(k = 0; k < 4; k++){ a = -0.6 + k * 0.4; pt(Math.cos(a) * 0.34, Math.sin(a) * 0.4, 0); }
      for(k = 0; k < 4; k++){ a = Math.PI - 0.6 + k * 0.4; pt(Math.cos(a) * 0.34, Math.sin(a) * 0.4, 0); }
    } else if(kind === 'heart'){
      for(k = 0; k < 22; k++){
        th = k / 22 * Math.PI * 2;
        pt((16 * Math.pow(Math.sin(th), 3)) / 17, -(13 * Math.cos(th) - 5 * Math.cos(2 * th) - 2 * Math.cos(3 * th) - Math.cos(4 * th)) / 17, 0);
      }
      pt(0, -0.1, 0); pt(-0.25, 0.1, 0); pt(0.25, 0.1, 0);
    } else if(kind === 'star'){
      for(k = 0; k < 10; k++){
        a = -Math.PI / 2 + k * Math.PI / 5;
        var rad = (k % 2 === 0) ? 0.95 : 0.42;
        pt(Math.cos(a) * rad, Math.sin(a) * rad, 0);
      }
      pt(0, 0, 0); pt(-0.2, 0.1, 0); pt(0.2, 0.1, 0);
    } else if(kind === 'lightbulb'){
      for(k = 0; k < 12; k++){ a = k / 12 * Math.PI * 2; pt(Math.cos(a) * 0.52, -0.18 + Math.sin(a) * 0.52, 0); }
      pt(-0.3, 0.32, 0); pt(0.3, 0.32, 0); pt(-0.24, 0.5, 0); pt(0.24, 0.5, 0);
      pt(-0.24, 0.66, 0); pt(0.24, 0.66, 0); pt(0, 0.78, 0);
      pt(-0.75, -0.75, 0); pt(0.75, -0.75, 0); pt(0, -0.95, 0);
    } else if(kind === 'rocket'){
      for(k = 0; k < 8; k++){ a = k / 8 * Math.PI * 2; pt(Math.cos(a) * 0.3, -0.1 + Math.sin(a) * 0.45, 0); }
      pt(0, -0.75, 0); pt(-0.12, -0.55, 0); pt(0.12, -0.55, 0);
      pt(0, -0.25, 0);
      pt(-0.3, 0.35, 0); pt(-0.42, 0.62, 0); pt(0.3, 0.35, 0); pt(0.42, 0.62, 0);
      pt(0, 0.55, 0); pt(0, 0.75, 0);
    } else if(kind === 'leaf'){
      var half = [[0,-1],[0.16,-0.7],[0.48,-0.82],[0.4,-0.52],[0.72,-0.5],[0.52,-0.28],[0.86,-0.12],[0.52,0.06],[0.66,0.34],[0.32,0.3],[0.28,0.66],[0.1,0.42],[0.08,0.95]];
      for(i = 0; i < half.length; i++){ pt(half[i][0], half[i][1], 0); pt(-half[i][0], half[i][1], 0); }
      pt(0, -0.5, 0); pt(0, 0, 0); pt(0, 0.4, 0);
    }
    return P;
  }

  function enterScene(i){
    dir.idx = i;
    var n = SCENES[i].n;
    dir.P = {x: W * (0.3 + Math.random() * 0.4), y: H * (0.32 + Math.random() * 0.36)};
    dir.Q = {x: W * (0.3 + Math.random() * 0.4), y: H * (0.32 + Math.random() * 0.36)};
    if(n === 'shape'){
      var kinds = ['atom','bird','butterfly','fish','tree','book','brain','quark','heart','star','lightbulb','rocket','leaf'];
      dir.shape = kinds[Math.floor(Math.random() * kinds.length)];
      dir.pts = shapePoints(dir.shape);
    }
    if(n === 'word'){
      var words = ['BUILD', 'DREAM', 'BRIMWOOD'];
      dir.word = words[dir.wcount % words.length]; dir.wcount++;
      var wp = wordPoints(dir.word);
      dir.wS = Math.min(17, (W * 0.86) / wp.widths, (H * 0.5) / 7);
      var pts = wp.pts, na = Math.max(1, actors.length);
      if(pts.length > na){
        var sub = [], stp = pts.length / na;
        for(var s2 = 0; s2 < na; s2++) sub.push(pts[Math.floor(s2 * stp)]);
        dir.wpts = sub;
      } else dir.wpts = pts;
    }
  }
  function sceneNow(t){
    var ct = t % TOTAL, acc = 0;
    for(var i = 0; i < SCENES.length; i++){
      acc += SCENES[i].d;
      if(ct < acc) return {i:i, local: ct - (acc - SCENES[i].d)};
    }
    return {i:0, local:0};
  }
  function spiralOff(i, scale){
    var a = i * 2.39996, r = (scale || 13) * Math.sqrt(i);
    return {x: Math.cos(a) * r, y: Math.sin(a) * r};
  }
  function haloTarget(ai, Px, Py, radius){
    var ha = ai * 2.4, hr = radius;
    return {x: Px + Math.cos(ha) * hr, y: Py + Math.sin(ha) * hr};
  }
  // shape target (absolute px) for actor ai
  function shapeTarget(d, ai, t, Px, Py, shape, pts){
    var S = dir.S, tx, ty;
    if(shape === 'atom'){
      if(ai === 0) return {x: Px, y: Py};
      var ring = ai % 2, kk = Math.floor(ai / 2);
      var per = Math.max(1, Math.ceil((actors.length - 1) / 2));
      var ang = t * 0.9 + kk * (Math.PI * 2 / per) + ring * 0.6;
      return {
        x: Px + Math.cos(ang) * S * (ring ? 0.95 : 0.62),
        y: Py + Math.sin(ang) * S * 0.3 * (ring ? 1 : -1)
      };
    }
    if(shape === 'quark'){
      if(ai < 3){
        var qa = ai * 2.094 + t * 0.6, qr = 15 + 7 * Math.sin(t * 2 + ai);
        return {x: Px + Math.cos(qa) * qr, y: Py + Math.sin(qa) * qr};
      }
      var s = spiralOff(ai - 3, 20);
      return {x: Px + s.x, y: Py + s.y};
    }
    if(ai < pts.length){
      var p0 = pts[ai];
      tx = Px + p0.x * S; ty = Py + p0.y * S;
      if(p0.w !== 0) ty += Math.sin(t * 2.4) * 13 * Math.abs(p0.x);
    } else {
      var h = haloTarget(ai, Px, Py, S * 1.45); tx = h.x; ty = h.y;
    }
    return {x: tx, y: ty};
  }
  // target offset (relative to home) for actor d
  function actorTarget(d, ai, t, scI, local, force){
    var n = SCENES[scI].n, s, g;
    if(force){
      g = shapeTarget(d, ai, t, force.x, force.y, force.shape, force.pts);
      return {x: g.x - d.bx, y: g.y - d.by};
    }
    if(n === 'drift'){
      return {x: Math.sin(t * 0.25 + d.jit) * 26, y: Math.cos(t * 0.2 + d.jit * 1.3) * 26};
    }
    if(n === 'gather'){
      s = spiralOff(ai);
      return {x: dir.P.x - d.bx + s.x, y: dir.P.y - d.by + s.y};
    }
    if(n === 'shape'){
      g = shapeTarget(d, ai, t, dir.P.x, dir.P.y, dir.shape, dir.pts);
      return {x: g.x - d.bx, y: g.y - d.by};
    }
    if(n === 'word'){
      var tx2, ty2;
      if(ai < dir.wpts.length){ tx2 = dir.P.x + dir.wpts[ai].x * dir.wS; ty2 = dir.P.y + dir.wpts[ai].y * dir.wS; }
      else { var h2 = haloTarget(ai, dir.P.x, dir.P.y, dir.wS * 9); tx2 = h2.x; ty2 = h2.y; }
      return {x: tx2 - d.bx, y: ty2 - d.by};
    }
    if(n === 'divide'){
      var C = (ai % 2 === 0) ? dir.P : dir.Q;
      s = spiralOff(ai >> 1);
      return {x: C.x - d.bx + s.x, y: C.y - d.by + s.y};
    }
    if(n === 'fight'){
      var midX = (dir.P.x + dir.Q.x) / 2, midY = (dir.P.y + dir.Q.y) / 2;
      if(local < 3){
        return {x: midX - d.bx + Math.sin(d.jit * 7 + t * 3) * 22, y: midY - d.by + Math.cos(d.jit * 5 + t * 3) * 22};
      }
      var dxs = d.bx - midX, dys = d.by - midY;
      var dl = Math.sqrt(dxs * dxs + dys * dys) || 1;
      var fl = 95 + ((d.jit * 37) % 55);
      return {x: dxs / dl * fl, y: dys / dl * fl};
    }
    if(n === 'army'){
      var col = ai % 8, row = Math.floor(ai / 8) % 12;
      return {
        x: dir.P.x + Math.sin(t * 0.35) * 70 + (col - 3.5) * 26 - d.bx,
        y: dir.P.y + (row - 5.5) * 26 - d.by
      };
    }
    return {x: 0, y: 0};
  }

  // cast a fresh set of lead dots: every cycle, different dots get a purpose
  function repickActors(){
    var d, k;
    for(k = 0; k < actors.length; k++){ d = actors[k]; d.actor = false; d.ai = -1; d.ax = 0; d.ay = 0; d.trail = []; }
    actors = [];
    var picked = {}, n = 0, guard = 0;
    while(n < MAXA && guard < dots.length * 4){
      guard++;
      var idx = Math.floor(Math.random() * dots.length);
      if(picked[idx]) continue;
      picked[idx] = 1;
      d = dots[idx];
      d.actor = true; d.ai = actors.length;
      actors.push(d); n++;
    }
  }

  function build(){
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    var r = cv.parentElement.getBoundingClientRect();
    W = r.width; H = r.height;
    CX = W / 2; CY = H / 2;
    cv.width = Math.max(1, Math.round(W * dpr));
    cv.height = Math.max(1, Math.round(H * dpr));
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    dots = []; actors = [];
    var nx = Math.ceil(W / GAP) + 2, ny = Math.ceil(H / GAP) + 2;
    for(var j = 0; j < ny; j++){
      for(var i = 0; i < nx; i++){
        dots.push({
          bx: i * GAP + 6, by: j * GAP + 6,
          ox: 0, oy: 0,
          br: 2.2 + Math.random() * 3.4,
          bp: Math.random() * Math.PI * 2,
          bd: 0.45 + Math.random() * 0.35,
          leader: Math.random() < 0.06,
          actor: false, ai: -1, ax: 0, ay: 0,
          eag: 0.028 + Math.random() * 0.03,
          jit: Math.random() * Math.PI * 2,
          trail: []
        });
      }
    }
    repickActors();
    dir.idx = -1;
    lastCyc = -1;
    if(reduced) draw(0);
  }

  function draw(t){
    ctx.clearRect(0, 0, W, H);
    if(!reduced){
      // the wave field retunes itself: new wavelength, speed, swirl and drift, eased in
      if(t > field.next){
        field.tWl = 60 + Math.random() * 80;
        field.tSp = 0.6 + Math.random() * 1.0;
        field.tTang = 8 + Math.random() * 12;
        field.tRad = 5 + Math.random() * 10;
        field.tRotSp = (Math.random() - 0.5) * 0.16;
        field.next = t + 16 + Math.random() * 10;
      }
      var fe = 0.02;
      field.wl += (field.tWl - field.wl) * fe;
      field.sp += (field.tSp - field.sp) * fe;
      field.tang += (field.tTang - field.tang) * fe;
      field.rad += (field.tRad - field.rad) * fe;
      field.rotSp += (field.tRotSp - field.rotSp) * fe;
      field.rot += field.rotSp / 60;
      if(field.rot > Math.PI * 2) field.rot -= Math.PI * 2;
      if(field.rot < -Math.PI * 2) field.rot += Math.PI * 2;
      // new cycle, new cast: different dots take the lead each time
      var cyc = Math.floor(t / TOTAL);
      if(cyc !== lastCyc){ lastCyc = cyc; repickActors(); }
    }
    smx += (mx - smx) * 0.08; smy += (my - smy) * 0.08;
    var sc = reduced ? null : sceneNow(t);
    if(sc && sc.i !== dir.idx) enterScene(sc.i);
    var force = (!reduced && summon.until > t) ? summon : null;
    var scName = sc ? SCENES[sc.i].n : '';
    var dimCrowd = (force || scName === 'shape' || scName === 'word') ? 0.5 : 1;
    var R2 = 130 * 130, k, d;
    ctx.fillStyle = '#ffffff';

    // summon ripples
    for(var ri = ripples.length - 1; ri >= 0; ri--){
      var age = t - ripples[ri].t0;
      if(age > 1.4){ ripples.splice(ri, 1); continue; }
      ctx.globalAlpha = (1 - age / 1.4) * 0.4;
      ctx.strokeStyle = '#ffffff'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.arc(ripples[ri].x, ripples[ri].y, 12 + age * 230, 0, 6.2832); ctx.stroke();
    }
    ctx.globalAlpha = 1;

    for(k = 0; k < dots.length; k++){
      d = dots[k];
      // vortex drift
      var dx0 = d.bx - CX, dy0 = d.by - CY;
      var rr = Math.sqrt(dx0 * dx0 + dy0 * dy0) || 1;
      var ang = Math.atan2(dy0, dx0) + field.rot;
      var ph = (rr / field.wl) * Math.PI * 2 - t * field.sp;
      var x = d.bx + (-Math.sin(ang)) * Math.sin(ph) * field.tang + Math.cos(ang) * Math.sin(ph * 0.5 + 1.3) * field.rad;
      var y = d.by + (Math.cos(ang)) * Math.sin(ph) * field.tang + Math.sin(ang) * Math.sin(ph * 0.5 + 1.3) * field.rad;
      // firefly breath
      var swell = Math.pow(0.5 + 0.5 * Math.sin(t * (Math.PI * 2 / d.br) + d.bp), 1.6);
      var a = (1 - d.bd) + d.bd * swell;
      a *= 0.85 + 0.15 * Math.sin(ph);
      if(d.leader) a = Math.min(1, a * 1.25);
      // the secret life
      if(d.actor && (sc || force)){
        var tg = actorTarget(d, d.ai, t, sc ? sc.i : 0, sc ? sc.local : 0, force);
        d.ax += (tg.x - d.ax) * d.eag;
        d.ay += (tg.y - d.ay) * d.eag;
        x += d.ax; y += d.ay;
      } else {
        a *= dimCrowd;
      }
      // cursor: nearby fireflies startle brighter and shy away
      var dx = x - smx, dy = y - smy, q = dx * dx + dy * dy;
      if(q < R2){
        var dist = Math.sqrt(q) || 1;
        var f = 1 - dist / 130;
        var push = f * 7;
        d.ox += ((dx / dist) * push - d.ox) * 0.12;
        d.oy += ((dy / dist) * push - d.oy) * 0.12;
        a = Math.min(1, a + f * 0.3);
      } else {
        d.ox *= 0.94; d.oy *= 0.94;
      }
      var fx = x + d.ox, fy = y + d.oy;
      // comet trails for actors
      if(d.actor && !reduced){
        var tr = d.trail, last = tr[tr.length - 1];
        var spd = last ? Math.sqrt((fx - last.x) * (fx - last.x) + (fy - last.y) * (fy - last.y)) : 99;
        if(spd > 0.6){ tr.push({x: fx, y: fy}); if(tr.length > 10) tr.shift(); }
        for(var ti = 0; ti < tr.length - 1; ti++){
          var f2 = ti / (tr.length - 1);
          ctx.globalAlpha = a * 0.32 * f2;
          ctx.beginPath(); ctx.arc(tr[ti].x, tr[ti].y, R * (0.3 + 0.55 * f2), 0, 6.2832); ctx.fill();
        }
      }
      ctx.globalAlpha = a;
      ctx.beginPath();
      ctx.arc(fx, fy, R, 0, 6.2832);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  function frame(now){
    nowT = (now - t0) / 1000;
    draw(nowT);
    requestAnimationFrame(frame);
  }

  cv.parentElement.addEventListener('pointermove', function(e){
    var r = cv.getBoundingClientRect();
    mx = e.clientX - r.left; my = e.clientY - r.top;
  });
  cv.parentElement.addEventListener('pointerleave', function(){ mx = -9999; my = -9999; });
  // left arrow key disabled on this page (text fields keep caret movement)
  window.addEventListener('keydown', function(e){
    if(e.key !== 'ArrowLeft') return;
    var t = e.target;
    if(t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) return;
    e.preventDefault();
  });
  cv.parentElement.addEventListener('pointerdown', function(e){
    var r = cv.getBoundingClientRect();
    var px = e.clientX - r.left, py = e.clientY - r.top;
    ripples.push({x: px, y: py, t0: nowT});
    if(ripples.length > 6) ripples.shift();
    var kinds = ['heart','star','lightbulb','rocket','leaf','bird','butterfly','fish'];
    summon.shape = kinds[Math.floor(Math.random() * kinds.length)];
    summon.pts = shapePoints(summon.shape);
    summon.x = px; summon.y = py;
    summon.until = nowT + 9;
  });

  if(window.ResizeObserver){
    new ResizeObserver(build).observe(cv.parentElement);
  } else {
    window.addEventListener('resize', build);
  }
  build();
  if(!reduced) requestAnimationFrame(frame);
})();

</script>
