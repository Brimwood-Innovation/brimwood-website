---
/* Comments moderation tab (Phase B): pending queue with Approve/Spam actions.
 * Self-contained — the first mate wires it into admin.astro as a tab panel.
 * Exposes window.loadCommentsTab() for tab-click loading; also auto-loads
 * on DOMContentLoaded if its container is present.
 */
const apiBase = import.meta.env.PUBLIC_API_BASE || "";
---

<div id="comments-tab-root" data-api-base={apiBase}>
  <div class="admin-row" id="commentFilters" style="margin-bottom:16px;"></div>
  <div id="commentQueue"><p class="admin-muted">Loading…</p></div>
</div>

<script is:inline src="/js/comments-tab.js"></script>
