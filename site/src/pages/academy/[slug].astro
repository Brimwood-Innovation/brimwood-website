---
/* Course detail: syllabus with lesson links and progress checkmarks.
 * Phase 2 slice 4: ported from prototype section 06 (v5 UX deck). The
 * deck course page is a breadcrumb (Academy / course), the title, a
 * sub line with the counts and the tagline, a Syllabus table (module,
 * lesson count, lesson titles), and an enrol row: Enrol (free for
 * members) with a Sign in to enrol link beside it. Lesson titles stay
 * links inside the table, so previews, lesson navigation, and the
 * progress checkmarks from academy-course.js keep working. */
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const apiBase = import.meta.env.PUBLIC_API_BASE || "";
  try {
    const r = await fetch(apiBase + "/api/courses", { headers: { accept: "application/json" } });
    const d = await r.json();
    if (d.ok) return d.courses.map((c: any) => ({ params: { slug: c.slug } }));
  } catch {}
  return [];
}

const { slug } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_BASE || "";
let course: any = null;
let modules: any[] = [];
try {
  const r = await fetch(apiBase + "/api/courses/" + encodeURIComponent(slug || ""), {
    headers: { accept: "application/json" },
  });
  const d = await r.json();
  if (d.ok) { course = d.course; modules = d.modules; }
} catch {}
if (!course) return Astro.redirect("/academy");

const allLessons = modules.flatMap((m: any) => m.lessons || []);
const totalMinutes = allLessons.reduce((sum: number, l: any) => sum + (l.duration_minutes || 0), 0);
const totalHours = totalMinutes >= 60 ? Math.round(totalMinutes / 60) : 0;
let counts = "";
if (modules.length) {
  counts = `${modules.length} module${modules.length === 1 ? "" : "s"}, ${allLessons.length} lesson${allLessons.length === 1 ? "" : "s"}`;
  if (totalHours) counts += `, about ${totalHours} hour${totalHours === 1 ? "" : "s"}`;
  counts += ".";
}
const sub = [counts, course.tagline].filter(Boolean).join(" ");
---

<Base
  title={`${course.title} - Academy - Brimwood Innovation`}
  description={course.tagline}
  path={`/academy/${slug}`}
  jsonld={{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Course",
        name: course.title,
        description: course.tagline,
        provider: { "@type": "Organization", name: "Brimwood Innovation", sameAs: "https://brimwoodinnovation.com" },
      },
      {
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: "https://brimwoodinnovation.com/" },
          { "@type": "ListItem", position: 2, name: "Academy", item: "https://brimwoodinnovation.com/academy" },
          { "@type": "ListItem", position: 3, name: course.title, item: `https://brimwoodinnovation.com/academy/${slug}` },
        ],
      },
    ],
  }}
>
  <section class="block academy-ui">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/academy">Academy</a></li>
        <li><span aria-current="page">{course.title}</span></li>
      </ol>
    </nav>
    <div class="kicker">{course.level}</div>
    <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">{course.title}</h1>
    <p class="sec-lede">{sub}</p>

    <div class="enrol-row" id="enrolWrap" data-slug={slug} data-api-base={apiBase}>
      <button class="btn" id="enrolBtn">Enrol (free for members)</button>
      <a class="btn btn-ghost" id="enrolSignin" href="/members">Sign in to enrol</a>
      <p id="enrolMsg" style="display:none;font-weight:600;color:var(--emerald-deep);"></p>
    </div>

    <div class="table-wrap">
      <table class="syllabus">
        <caption>Syllabus</caption>
        <tbody>
          {modules.map((m, mi) => (
            <tr>
              <th scope="row">Module {mi + 1}: {m.title}</th>
              <td>{m.lessons.length} lesson{m.lessons.length === 1 ? "" : "s"}</td>
              <td>
                {m.lessons.map((l: any, li: number) => (
                  <>
                    {li > 0 && ", "}
                    <a href={`/academy/${course.slug}/${l.id}`} data-lesson-id={l.id} class="lesson-link"><span class="done-mark" style="display:none;color:var(--emerald-deep);">✓ </span>{l.title}</a>{l.is_preview && <span class="preview-tag"> (preview)</span>}
                  </>
                ))}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline src="/js/academy-course.js"></script>
</Base>
