---
/* Course detail: modules + lesson index with progress checkmarks. Brand-kit styled. */
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const apiBase = import.meta.env.PUBLIC_API_BASE || "";
  try {
    const r = await fetch(apiBase + "/api/courses", { headers: { accept: "application/json" } });
    const d = await r.json();
    if (d.ok) return d.courses.map((c: any) => ({ params: { slug: c.slug } }));
  } catch {}
  return [];
}

const { slug } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_BASE || "";
let course: any = null;
let modules: any[] = [];
try {
  const r = await fetch(apiBase + "/api/courses/" + encodeURIComponent(slug || ""), {
    headers: { accept: "application/json" },
  });
  const d = await r.json();
  if (d.ok) { course = d.course; modules = d.modules; }
} catch {}
if (!course) return Astro.redirect("/academy");
---

<Base title={`${course.title} — Academy — Brimwood Innovation`} description={course.tagline}>
  <section class="block">
    <a href="/academy" style="font-size:14px;">← All courses</a>
    <div class="kicker" style="margin-top:24px;">{course.level}</div>
    <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">{course.title}</h1>
    <p class="sec-lede">{course.tagline}</p>

    <div style="margin-bottom:32px;">
      <button class="btn" id="enrolBtn">Enrol in this course</button>
      <p id="enrolMsg" style="display:none;font-weight:600;color:var(--emerald-deep);"></p>
    </div>

    {modules.map((m) => (
      <div style="margin-top:40px;">
        <h3 style="font-size:20px;margin-bottom:16px;">{m.title}</h3>
        <div class="cards" style="grid-template-columns:1fr;">
          {m.lessons.map((l: any) => (
            <a
              href={`/academy/${course.slug}/${l.id}`}
              data-lesson-id={l.id}
              class="card lesson-link"
              style="text-decoration:none;display:flex;justify-content:space-between;align-items:center;padding:20px 24px;"
            >
              <span style="font-weight:600;">
                <span class="done-mark" style="display:none;color:var(--emerald);margin-right:8px;">✓</span>{l.title}
              </span>
              <span class="n" style="margin:0;">{l.is_preview ? "Preview" : "Members"} · {l.duration_minutes || "–"} min</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

  <script define:vars={{ slug, apiBase }}>
    // Enrol + progress checkmarks.
    (async () => {
      try {
        const pr = await fetch(apiBase + "/api/progress", {
          headers: { accept: "application/json" },
          credentials: "include",
        });
        const d = await pr.json().catch(() => ({}));
        if (!d.ok) return;
        if ((d.enrolments || []).some((e) => e.slug === slug)) {
          document.getElementById("enrolBtn").style.display = "none";
          const msg = document.getElementById("enrolMsg");
          msg.style.display = "block";
          msg.textContent = "You're enrolled in this course.";
        }
        const dr = await fetch(apiBase + "/api/progress/detail", {
          headers: { accept: "application/json" },
          credentials: "include",
        });
        const dd = await dr.json().catch(() => ({}));
        const doneIds = new Set(dd.ok ? dd.done || [] : []);
        document.querySelectorAll(".lesson-link").forEach((a) => {
          if (doneIds.has(a.dataset.lessonId)) {
            a.querySelector(".done-mark").style.display = "inline";
            a.style.borderColor = "var(--emerald)";
          }
        });
      } catch {}
    })();

    document.getElementById("enrolBtn").addEventListener("click", async () => {
      const btn = document.getElementById("enrolBtn");
      const msg = document.getElementById("enrolMsg");
      btn.disabled = true; btn.textContent = "Enrolling…";
      try {
        const r = await fetch(apiBase + "/api/enrol/" + encodeURIComponent(slug), {
          method: "POST",
          credentials: "include",
          headers: { accept: "application/json" },
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || !d.ok) throw new Error(d.error || "enrol failed");
        btn.style.display = "none";
        msg.style.display = "block";
        msg.textContent = "You're enrolled. Start with the first lesson below.";
      } catch (e) {
        btn.disabled = false; btn.textContent = "Enrol in this course";
        msg.style.display = "block";
        msg.textContent = e.message === "Sign in required" ? "Please sign in first." : "Could not enrol. Try again.";
      }
    });
  </script>
</Base>
