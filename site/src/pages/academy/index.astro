---
/* Academy index (T21): list published courses. Brand-kit styled. */
import Base from "../../layouts/Base.astro";
const apiBase = import.meta.env.PUBLIC_API_BASE || "";
let courses: any[] = [];
try {
  const r = await fetch(apiBase + "/api/courses", { headers: { accept: "application/json" } });
  const d = await r.json();
  if (d.ok) courses = d.courses;
} catch {}
---

<Base title="Academy — Brimwood Innovation" description="Courses for builders. Learn by shipping.">
  <section class="block">
    <div class="kicker">Academy</div>
    <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">Learn by shipping.</h1>
    <p class="sec-lede">Courses for builders. Previews are open to everyone; full lessons are for members.</p>

    <div class="cards" style="grid-template-columns:repeat(2,1fr);">
      {courses.map((c) => (
        <a href={`/academy/${c.slug}`} class="card" style="text-decoration:none;display:block;">
          <div class="n">{c.level}</div>
          <h3>{c.title}</h3>
          <p>{c.tagline}</p>
        </a>
      ))}
    </div>
    {courses.length === 0 && (
      <p class="sec-lede">No courses published yet. Check back soon.</p>
    )}
  </section>
</Base>
