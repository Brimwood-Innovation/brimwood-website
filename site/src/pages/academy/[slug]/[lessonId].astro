---
/* Lesson view: preview lessons render; members-only lessons show a gate.
 * Completed state + prev/next navigation, all client-side aware. */
import Base from "../../../layouts/Base.astro";

export async function getStaticPaths() {
  const apiBase = import.meta.env.PUBLIC_API_BASE || "";
  const paths: any[] = [];
  try {
    const r = await fetch(apiBase + "/api/courses", { headers: { accept: "application/json" } });
    const d = await r.json();
    if (d.ok) {
      for (const c of d.courses) {
        const cr = await fetch(apiBase + "/api/courses/" + encodeURIComponent(c.slug), {
          headers: { accept: "application/json" },
        });
        const cd = await cr.json();
        if (cd.ok) {
          for (const m of cd.modules) {
            for (const l of m.lessons) {
              paths.push({ params: { slug: c.slug, lessonId: l.id } });
            }
          }
        }
      }
    }
  } catch {}
  return paths;
}

const { slug, lessonId } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_BASE || "";
let lesson: any = null;
let gated = false;
let prevLesson: any = null;
let nextLesson: any = null;
try {
  const r = await fetch(apiBase + "/api/courses/lessons/" + encodeURIComponent(lessonId || ""), {
    headers: { accept: "application/json" },
  });
  const d = await r.json();
  if (d.ok) {
    lesson = d.lesson;
    // Build prev/next from the course's ordered lesson list.
    const cr = await fetch(apiBase + "/api/courses/" + encodeURIComponent(lesson.course_slug), {
      headers: { accept: "application/json" },
    });
    const cd = await cr.json();
    if (cd.ok) {
      const flat: any[] = [];
      for (const m of cd.modules) for (const l of m.lessons) flat.push(l);
      const idx = flat.findIndex((l) => l.id === lessonId);
      if (idx > 0) prevLesson = flat[idx - 1];
      if (idx >= 0 && idx < flat.length - 1) nextLesson = flat[idx + 1];
    }
  } else if (r.status === 401 || r.status === 403) gated = true;
} catch {}
---

<Base title={`${lesson ? lesson.title : "Lesson"} — Academy — Brimwood Innovation`} description={lesson ? lesson.title : "Brimwood Academy lesson"}>
  <section style="max-width:760px;margin:0 auto;padding:64px 20px;">
    {lesson ? (
      <>
        <a href={`/academy/${lesson.course_slug}`} style="color:#0C9463;font-size:14px;">← {lesson.course_title}</a>
        <h1 style="font-size:36px;margin:24px 0 8px;color:#121A16;">{lesson.title}</h1>
        <p style="color:#5B6862;font-size:14px;margin:0 0 32px;">
          {lesson.duration_minutes ? `${lesson.duration_minutes} min` : ""} {lesson.is_preview ? "· Preview" : "· Members"}
        </p>
        {lesson.video_r2_key && (
          <video
            controls
            preload="metadata"
            playsinline
            style="width:100%;border-radius:12px;background:#121A16;margin-bottom:32px;"
            src={`${apiBase}/api/video/${lesson.video_r2_key}`}
          />
        )}
        <div style="font-size:17px;line-height:1.7;color:#121A16;white-space:pre-wrap;">{lesson.body_md}</div>

        <div style="margin-top:40px;" id="completeWrap">
          <button id="completeBtn" style="background:#0C9463;color:#fff;border:0;border-radius:10px;padding:12px 28px;font-size:15px;font-weight:600;cursor:pointer;">
            Mark as complete
          </button>
          <p id="completeMsg" style="display:none;font-weight:600;"></p>
        </div>

        <nav style="display:flex;justify-content:space-between;margin-top:48px;padding-top:24px;border-top:1px solid rgba(18,26,22,.08);">
          <span>
            {prevLesson && (
              <a href={`/academy/${slug}/${prevLesson.id}`} style="color:#0C9463;font-weight:600;">← {prevLesson.title}</a>
            )}
          </span>
          <span>
            {nextLesson && (
              <a href={`/academy/${slug}/${nextLesson.id}`} style="color:#0C9463;font-weight:600;">{nextLesson.title} →</a>
            )}
          </span>
        </nav>

        <script define:vars={{ lessonId, apiBase }}>
          (async () => {
            const btn = document.getElementById("completeBtn");
            const msg = document.getElementById("completeMsg");
            // Check if already completed.
            try {
              const pr = await fetch(apiBase + "/api/progress/detail", {
                headers: { accept: "application/json" },
                credentials: "include",
              });
              const pd = await pr.json().catch(() => ({}));
              if (pd.ok && (pd.done || []).includes(lessonId)) {
                btn.style.display = "none";
                msg.style.display = "block";
                msg.style.color = "#0C9463";
                msg.textContent = "✓ Completed";
                return;
              }
            } catch {}
            btn.addEventListener("click", async () => {
              btn.disabled = true; btn.textContent = "Saving…";
              try {
                const r = await fetch(apiBase + "/api/progress/" + encodeURIComponent(lessonId), {
                  method: "POST",
                  credentials: "include",
                  headers: { accept: "application/json" },
                });
                const d = await r.json().catch(() => ({}));
                if (!r.ok || !d.ok) throw new Error(d.error || "save failed");
                btn.style.display = "none";
                msg.style.display = "block";
                msg.style.color = "#0C9463";
                msg.textContent = "✓ Completed — nice work.";
              } catch (e) {
                btn.disabled = false; btn.textContent = "Mark as complete";
                msg.style.display = "block"; msg.style.color = "#c0392b";
                msg.textContent = e.message === "Sign in required" ? "Please sign in first." : "Could not save. Try again.";
              }
            });
          })();
        </script>
      </>
    ) : gated ? (
      <>
        <h1 style="font-size:36px;color:#121A16;">Members only</h1>
        <p style="font-size:18px;color:#5B6862;" id="gateMsg">
          This lesson is for Brimwood members. <a href="/members" style="color:#0C9463;">Sign in</a> to continue learning.
        </p>
        <div id="lessonBody" style="display:none;"></div>
        <script define:vars={{ lessonId, slug, apiBase }}>
          // If signed in, retry with credentials — the API will return the full lesson.
          (async () => {
            try {
              const r = await fetch(apiBase + "/api/courses/lessons/" + encodeURIComponent(lessonId), {
                headers: { accept: "application/json" },
                credentials: "include",
              });
              const d = await r.json();
              if (d.ok && d.lesson) location.reload(); // Re-render server-side now that we're authed.
            } catch {}
          })();
        </script>
      </>
    ) : (
      <>
        <h1 style="font-size:36px;color:#121A16;">Not found</h1>
        <p style="color:#5B6862;">This lesson does not exist or is not published.</p>
      </>
    )}
  </section>
</Base>
