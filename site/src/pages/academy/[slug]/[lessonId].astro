---
/* Lesson view: preview lessons render; members-only gated.
 * Phase 2 slice 4: ported from prototype section 06 (v5 UX deck). The
 * deck lesson screen is a breadcrumb (Academy / course / Lesson N of
 * M), the title with a module and minutes meta line, the lesson body,
 * and a reflection panel: there is no Mark complete, submitting the
 * reflection completes the lesson (D6) and opens the next one. The
 * panel posts { reflection } to POST /api/progress/:lessonId, the
 * contract Phase 1 shipped; on the lesson that completes a course the
 * response carries the automatically issued certificate (Phase 4 slice
 * 2), shown in the certificate line below. The old Mark as complete button sent no
 * reflection and could not complete a lesson. The deck's notes and
 * transcript tabs and its reflection visibility choice are not
 * ported: the API returns one body field and reflections are private,
 * with no transcript and no sharing support yet. */
import Base from "../../../layouts/Base.astro";

export async function getStaticPaths() {
  const apiBase = import.meta.env.PUBLIC_API_BASE || "";
  const paths: any[] = [];
  try {
    const r = await fetch(apiBase + "/api/courses", { headers: { accept: "application/json" } });
    const d = await r.json();
    if (d.ok) {
      for (const c of d.courses) {
        const cr = await fetch(apiBase + "/api/courses/" + encodeURIComponent(c.slug), {
          headers: { accept: "application/json" },
        });
        const cd = await cr.json();
        if (cd.ok) {
          for (const m of cd.modules) {
            for (const l of m.lessons) {
              paths.push({ params: { slug: c.slug, lessonId: l.id } });
            }
          }
        }
      }
    }
  } catch {}
  return paths;
}

const { slug, lessonId } = Astro.params;
const apiBase = import.meta.env.PUBLIC_API_BASE || "";
let lesson: any = null;
let gated = false;
try {
  const r = await fetch(apiBase + "/api/courses/lessons/" + encodeURIComponent(lessonId || ""), {
    headers: { accept: "application/json" },
  });
  const d = await r.json();
  if (d.ok) lesson = d.lesson;
  else if (r.status === 401 || r.status === 403) gated = true;
} catch {}

/* Course outline for the breadcrumb, the Lesson N of M position, the
 * module line, and prev/next. Public data; best effort. */
let courseTitle: string | null = lesson ? lesson.course_title : null;
let flat: any[] = [];
try {
  const cr = await fetch(apiBase + "/api/courses/" + encodeURIComponent(slug || ""), {
    headers: { accept: "application/json" },
  });
  const cd = await cr.json();
  if (cd.ok) {
    courseTitle = cd.course.title;
    cd.modules.forEach((m: any, mi: number) => {
      for (const l of m.lessons) flat.push({ ...l, moduleNo: mi + 1 });
    });
  }
} catch {}
const idx = flat.findIndex((l) => l.id === lessonId);
const prevLesson = idx > 0 ? flat[idx - 1] : null;
const nextLesson = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : null;
const lessonNo = idx >= 0 ? idx + 1 : null;
const moduleNo = idx >= 0 ? flat[idx].moduleNo : null;

const metaParts: string[] = [];
if (lesson) {
  if (moduleNo) metaParts.push(`Module ${moduleNo}`);
  if (lesson.duration_minutes) metaParts.push(lesson.video_r2_key ? `${lesson.duration_minutes} min video` : `${lesson.duration_minutes} min`);
  if (lesson.is_preview) metaParts.push("Preview");
}
const pageTitle = lesson ? lesson.title : "Lesson";
const crumbItems: any[] = [
  { "@type": "ListItem", position: 1, name: "Home", item: "https://brimwoodinnovation.com/" },
  { "@type": "ListItem", position: 2, name: "Academy", item: "https://brimwoodinnovation.com/academy" },
];
if (courseTitle) {
  crumbItems.push({ "@type": "ListItem", position: 3, name: courseTitle, item: `https://brimwoodinnovation.com/academy/${slug}` });
  crumbItems.push({ "@type": "ListItem", position: 4, name: lesson ? lesson.title : "Lesson", item: `https://brimwoodinnovation.com/academy/${slug}/${lessonId}` });
}
---

<Base
  title={`${pageTitle} - Academy - Brimwood Innovation`}
  description={lesson ? lesson.title : "Brimwood Academy lesson"}
  path={`/academy/${slug}/${lessonId}`}
  jsonld={{ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: crumbItems }}
>
  <section class="block academy-ui">
    {lesson ? (
      <>
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/academy">Academy</a></li>
            <li><a href={`/academy/${lesson.course_slug}`}>{lesson.course_title}</a></li>
            <li><span aria-current="page">{lessonNo ? `Lesson ${lessonNo} of ${flat.length}` : lesson.title}</span></li>
          </ol>
        </nav>
        {metaParts.length > 0 && <div class="kicker" style="margin-top:24px;">{metaParts.join(" · ")}</div>}
        <h1 class="sec" style="font-size:clamp(28px,4vw,44px);margin-bottom:18px;">{lesson.title}</h1>
        {lesson.video_r2_key && (
          <video
            controls
            preload="metadata"
            playsinline
            style="width:100%;border-radius:16px;background:var(--ink);margin:24px 0;"
            src={`${apiBase}/api/video/${lesson.video_r2_key}`}
          />
        )}
        <div class="prose" style="padding:0;max-width:none;">
          <p style="white-space:pre-wrap;">{lesson.body_md}</p>
        </div>

        <div class="reflection" id="completeWrap" data-lesson-id={lessonId} data-api-base={apiBase} data-slug={slug}>
          <form id="reflectionForm" novalidate>
            <label for="reflectionBody">Your reflection</label>
            <textarea id="reflectionBody" rows="5" maxlength="2000" aria-describedby="reflectionHint reflectionMsg"></textarea>
            <p class="hint" id="reflectionHint">20 characters or more. Private by default.</p>
            <p id="reflectionMsg" role="status" style="display:none;font-weight:600;margin-top:12px;"></p>
            <button class="btn" id="reflectionBtn" type="submit" style="margin-top:16px;">Submit reflection</button>
            <p class="progress-line" id="progressLine" hidden>Your progress: <b id="progressText"></b></p>
            <p id="certLine" role="status" hidden>Course complete. Your certificate is ready: <a id="certLink" href="#">View certificate</a></p>
          </form>
        </div>

        <nav style="display:flex;justify-content:space-between;margin-top:48px;padding-top:24px;border-top:1px solid rgba(18,26,22,.08);">
          <span>{prevLesson && <a class="btn btn-ghost small" href={`/academy/${slug}/${prevLesson.id}`}>← Previous</a>}</span>
          <span>{nextLesson && <a class="btn btn-ghost small" id="nextLessonLink" href={`/academy/${slug}/${nextLesson.id}`}>Next lesson →</a>}</span>
        </nav>
        <p class="gate-note" id="nextGateNote" hidden>Submit your reflection to finish this lesson.</p>

        <script is:inline src="/js/academy-lesson.js"></script>
      </>
    ) : gated ? (
      <div style="text-align:center;padding:48px 0;" id="gateWrap" data-lesson-id={lessonId} data-api-base={apiBase} data-slug={slug}>
        <div class="kicker">Members only</div>
        <h2 class="sec">This lesson is for members.</h2>
        <p class="sec-lede" style="margin-inline:auto;" id="gateMsg"><a href="/members">Sign in</a> to continue learning.</p>
      </div>
      <div id="lessonBody" style="display:none;text-align:left;"></div>
      <script is:inline src="/js/academy-lesson.js"></script>
    ) : (
      <div style="text-align:center;padding:48px 0;">
        <h2 class="sec">Not found</h2>
        <p class="sec-lede" style="margin-inline:auto;">This lesson does not exist or is not published.</p>
      </div>
    )}
  </section>
</Base>
