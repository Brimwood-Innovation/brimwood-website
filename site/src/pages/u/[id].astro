---
/* Public member profile by id (Phase D2): prerendered at build time for
 * proper OG tags (shareable). Client-side refresh keeps it fresh.
 * Only show_profile=1 AND status='active' are generated. Fields are filtered
 * server-side by the API's per-field visibility; the page renders sections
 * (About, Hobbies, Achievements, Education, Milestones) for whatever arrives. */
import Base from "../../layouts/Base.astro";
import ProfileView from "../../components/ProfileView.astro";

export async function getStaticPaths() {
  const apiBase = import.meta.env.PUBLIC_API_BASE || "";
  try {
    const r = await fetch(apiBase + "/api/users/public", { headers: { accept: "application/json" } });
    const d = await r.json();
    if (d.ok && Array.isArray(d.users)) {
      const paths = [];
      for (const u of d.users) {
        try {
          const pr = await fetch(apiBase + "/api/users/" + encodeURIComponent(u.id), {
            headers: { accept: "application/json" },
          });
          const pd = await pr.json();
          if (pr.ok && pd.ok) paths.push({ params: { id: u.id }, props: { profile: pd.user } });
        } catch {}
      }
      return paths;
    }
  } catch {}
  return [];
}

const { id } = Astro.params;
const profile = Astro.props.profile;
const apiBase = import.meta.env.PUBLIC_API_BASE || "";
const ogTitle = `${profile.display_name} — Brimwood Innovation`;
const ogDesc = profile.bio?.slice(0, 160) || "A Brimwood Innovation member.";
const ogImage = profile.avatar_url
  ? `https://brimwoodinnovation.com${profile.avatar_url}`
  : undefined;
/* Canonical alignment (audit/social/wiring): /@username is the canonical
 * profile URL; /u/<id> is the stable alias. Client JS redirects to the
 * canonical URL when a username is known (see profile-actions.js). */
const canonicalPath = profile.username ? `/@${profile.username}` : `/u/${id}`;
---

<Base title={ogTitle} description={ogDesc} path={`/u/${id}`} canonicalPath={canonicalPath} image={ogImage}>
  <ProfileView profile={profile} profileKey={id} apiBase={apiBase} />
  <script is:inline src="/js/profile-actions.js"></script>
</Base>
