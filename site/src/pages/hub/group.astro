---
/* Member group detail (Phase 3 slice 6, deck section 20 groups screen).
 * The group header, its join policy action, and its recent posts.
 * Posts stay visible only to active group members; everyone else sees
 * the join action. Archived groups keep their posts and show the
 * reopen action to a group admin or staff.
 * The deck route is /hub/g/SLUG; this static-first site (no adapter)
 * serves it through the public/_redirects rewrite to this page with
 * ?slug=, and this page also reads a trailing path segment, so the
 * same page works locally at /hub/group?slug=.
 * All data loads client-side from /api/groups; signed-out visitors see
 * the sign-in prompt.
 */
import Base from "../../layouts/Base.astro";
import HubShell from "../../components/HubShell.astro";
---

<Base
  title="Group - Brimwood Innovation"
  description="A member group at Brimwood Innovation."
  path="/hub/groups"
>
  <HubShell current="groups">
  <section class="block" id="group-loading">
    <div class="kicker">Members</div>
    <p class="sec-lede">Checking your session…</p>
  </section>

  <section class="block" id="group-login" style="display:none;text-align:center;padding:48px 0;">
    <div class="kicker">Members</div>
    <h1 class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:18px;">Sign in to see this group.</h1>
    <p class="sec-lede" style="margin-inline:auto;"><a href="/members">Sign in</a> to continue.</p>
  </section>

  <section class="block" id="group-missing" style="display:none;text-align:center;padding:48px 0;">
    <div class="kicker">Members</div>
    <h1 class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:18px;">No such group.</h1>
    <p class="sec-lede" style="margin-inline:auto;"><a href="/hub/groups">Back to all groups</a>.</p>
  </section>

  <section class="block" id="group-app" style="display:none;max-width:720px;">
    <div class="kicker"><a href="/hub/groups">Groups</a></div>
    <h1 id="group-name" class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:8px;"></h1>
    <p id="group-purpose" class="sec-lede" style="margin-bottom:8px;"></p>
    <p id="group-meta" class="thread-sub" style="margin-bottom:16px;"></p>
    <p id="group-error" class="thread-sub" style="display:none;color:var(--brimwood-red, #b42318);"></p>
    <div id="group-actions" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px;"></div>
    <div id="group-posts" style="display:grid;gap:14px;"></div>
    <p id="group-posts-note" class="sec-lede" style="display:none;"></p>
  </section>

  <dialog id="detail-join-dialog" aria-labelledby="detail-join-title" style="max-width:520px;width:calc(100% - 32px);border:1px solid rgba(18,26,22,0.14);border-radius:12px;padding:22px;">
    <h2 id="detail-join-title" style="font-size:22px;margin-bottom:6px;">Join this group</h2>
    <p class="thread-sub" style="margin-bottom:16px;">The group admin reads your answers. You join when they approve.</p>
    <form id="detail-join-form" method="dialog">
      <div id="detail-join-questions" style="display:grid;gap:14px;"></div>
      <p id="detail-join-error" class="thread-sub" style="display:none;color:var(--brimwood-red, #b42318);margin-top:10px;"></p>
      <div style="display:flex;gap:8px;margin-top:18px;">
        <button type="submit" class="btn btn-primary btn-sm">Send request</button>
        <button type="button" class="btn btn-ghost btn-sm" id="detail-join-cancel">Cancel</button>
      </div>
    </form>
  </dialog>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_BASE || "";
    const withCreds = { credentials: "include" };
    // Canonical escaper: window.Brimwood.escapeHtml (site/public/js/escape.js), loaded by Base before this script.
    const esc = window.Brimwood.escapeHtml;
    const $ = (id) => document.getElementById(id);
    const show = (id) => ($(id).style.display = "");
    const hide = (id) => ($(id).style.display = "none");
    const slug = new URLSearchParams(window.location.search).get("slug")
      || window.location.pathname.split("/").filter(Boolean).pop();

    let group = null;
    let questions = [];

    function relTime(iso) {
      const t = new Date(iso).getTime();
      const diff = Date.now() - t;
      if (diff < 60e3) return "now";
      if (diff < 3600e3) return Math.floor(diff / 60e3) + "m ago";
      if (diff < 864e5) return Math.floor(diff / 3600e3) + "h ago";
      return new Date(t).toLocaleDateString(undefined, { day: "numeric", month: "short" });
    }

    function policyLabel(p) {
      return p === "open" ? "Open" : p === "request" ? "Ask to join" : "Invite only";
    }

    function renderActions() {
      const box = $("group-actions");
      if (group.my_state === "active") {
        box.innerHTML = group.status === "archived" && group.can_reopen
          ? `<button type="button" class="btn btn-ghost btn-sm" id="btn-reopen">Reopen</button>`
          : `<span class="thread-sub">You are a member of this group.</span>`;
      } else if (group.my_state === "requested") {
        box.innerHTML = `<button type="button" class="btn btn-ghost btn-sm" disabled>Request sent</button>`;
      } else if (group.status === "archived") {
        box.innerHTML = group.can_reopen
          ? `<button type="button" class="btn btn-primary btn-sm" id="btn-reopen">Reopen</button>`
          : `<span class="thread-sub">This group is archived. All posts are kept.</span>`;
      } else if (group.join_policy === "open") {
        box.innerHTML = `<button type="button" class="btn btn-primary btn-sm" id="btn-join">Join</button>`;
      } else if (group.join_policy === "request") {
        box.innerHTML = `<button type="button" class="btn btn-primary btn-sm" id="btn-request">Request to join</button>`;
      } else {
        box.innerHTML = `<span class="thread-sub">This group is invite only.</span>`;
      }
      const join = $("btn-join");
      if (join) join.addEventListener("click", joinOpen);
      const req = $("btn-request");
      if (req) req.addEventListener("click", openJoinDialog);
      const reopen = $("btn-reopen");
      if (reopen) reopen.addEventListener("click", reopenGroup);
    }

    function renderPosts(posts) {
      const box = $("group-posts");
      const note = $("group-posts-note");
      if (group.my_state !== "active") {
        box.innerHTML = "";
        note.textContent = group.status === "archived"
          ? "Archived groups keep their posts. A member can read them after reopening."
          : "Join this group to see its posts.";
        show("group-posts-note");
        return;
      }
      hide("group-posts-note");
      if (!posts.length) {
        box.innerHTML = `<p class="sec-lede">No posts in this group yet.</p>`;
        return;
      }
      box.innerHTML = posts.map((p) => `
        <article class="card" style="padding:16px 18px;">
          <p style="margin:0 0 6px;"><strong>${esc(p.display_name || "Member")}</strong> <span class="thread-sub">${p.username ? "@" + esc(p.username) + " · " : ""}${relTime(p.created_at)}</span></p>
          <p style="margin:0;white-space:pre-wrap;">${esc(p.body)}</p>
        </article>`).join("");
    }

    async function loadGroup() {
      const r = await fetch(API_BASE + `/api/groups/${encodeURIComponent(slug)}`, { ...withCreds });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || !d.ok) { hide("group-loading"); hide("group-app"); show("group-missing"); return; }
      group = d.group;
      questions = d.questions || [];
      $("group-name").textContent = group.name;
      $("group-purpose").textContent = group.purpose;
      const activity = group.posts_this_week === 1 ? "1 post this week" : group.posts_this_week + " posts this week";
      const last = group.last_post_at ? " · last post " + relTime(group.last_post_at) : "";
      $("group-meta").textContent = policyLabel(group.join_policy)
        + (group.status === "archived" ? " · Archived" : "")
        + " · " + activity + last;
      document.title = group.name + " - Brimwood Innovation";
      renderActions();
      renderPosts(d.posts || []);
      hide("group-loading"); hide("group-missing"); show("group-app");
    }

    async function joinOpen() {
      const r = await fetch(API_BASE + `/api/groups/${encodeURIComponent(slug)}/join`, { method: "POST", ...withCreds });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || !d.ok) {
        const e = $("group-error");
        e.textContent = d.error || "Could not join that group.";
        show("group-error");
        return;
      }
      await loadGroup();
    }

    function openJoinDialog() {
      $("detail-join-title").textContent = "Join " + group.name;
      $("detail-join-questions").innerHTML = questions.map((q) => {
        if (q.kind === "yes_no") {
          return `<fieldset style="border:0;padding:0;margin:0;"><legend style="font-weight:600;margin-bottom:6px;">${esc(q.prompt)}</legend>
            <label style="margin-right:14px;"><input type="radio" name="dq-${esc(q.id)}" value="Yes" ${q.required ? "required" : ""} /> Yes</label>
            <label><input type="radio" name="dq-${esc(q.id)}" value="No" /> No</label></fieldset>`;
        }
        return `<label style="display:block;font-weight:600;">${esc(q.prompt)}
          <textarea name="dq-${esc(q.id)}" rows="2" maxlength="500" style="display:block;width:100%;margin-top:6px;font:inherit;font-weight:400;padding:8px 10px;border:1px solid rgba(18,26,22,0.14);border-radius:8px;" ${q.required ? "required" : ""}></textarea></label>`;
      }).join("");
      hide("detail-join-error");
      $("detail-join-dialog").showModal();
    }

    async function reopenGroup() {
      const r = await fetch(API_BASE + `/api/groups/${encodeURIComponent(slug)}/reopen`, { method: "POST", ...withCreds });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || !d.ok) {
        const e = $("group-error");
        e.textContent = d.error || "Could not reopen that group.";
        show("group-error");
        return;
      }
      await loadGroup();
    }

    $("detail-join-cancel").addEventListener("click", () => $("detail-join-dialog").close());
    $("detail-join-form").addEventListener("submit", async (ev) => {
      ev.preventDefault();
      const answers = questions.map((q) => {
        let value = "";
        if (q.kind === "yes_no") {
          const picked = document.querySelector(`input[name="dq-${CSS.escape(q.id)}"]:checked`);
          value = picked ? picked.value : "";
        } else {
          const field = document.querySelector(`[name="dq-${CSS.escape(q.id)}"]`);
          value = field ? field.value : "";
        }
        return { question_id: q.id, answer: value };
      });
      const res = await fetch(API_BASE + `/api/groups/${encodeURIComponent(slug)}/join`, {
        method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ answers }), ...withCreds,
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.ok) {
        const e = $("detail-join-error");
        e.textContent = out.error || "Could not send that request.";
        show("detail-join-error");
        return;
      }
      $("detail-join-dialog").close();
      await loadGroup();
    });

    (async () => {
      try {
        const me = await fetch(API_BASE + "/api/auth/me", { headers: { accept: "application/json" }, ...withCreds });
        const d = await me.json().catch(() => ({}));
        if (!me.ok || !d.ok) throw 0;
        hide("group-loading"); hide("group-login");
        await loadGroup();
      } catch {
        hide("group-loading"); hide("group-app"); hide("group-missing"); show("group-login");
      }
    })();
  </script>
  </HubShell>
</Base>
