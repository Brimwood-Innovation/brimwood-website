---
/* Post permalink (social-UX reconciliation): the landing target for
 * notification deep links (mentions, replies, poll results) and shares.
 * Members-only; signed-out visitors see the sign-in prompt. */
import Base from "../../../layouts/Base.astro";
---

<Base
  title="Post — Brimwood Innovation"
  description="A post from a Brimwood member."
  path="/hub/post/"
>
  <section class="block" id="pp-loading">
    <div class="kicker">Members</div>
    <p class="sec-lede">Loading post…</p>
  </section>

  <section class="block" id="pp-login" style="display:none;text-align:center;padding:48px 0;">
    <div class="kicker">Members</div>
    <h1 class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:18px;">Sign in to view this post.</h1>
    <p class="sec-lede" style="margin-inline:auto;"><a href="/members">Sign in</a> to continue.</p>
  </section>

  <section class="block" id="pp-missing" style="display:none;text-align:center;padding:48px 0;">
    <div class="kicker">Members</div>
    <h1 class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:18px;">This post is gone.</h1>
    <p class="sec-lede" style="margin-inline:auto;"><a href="/hub/feed">Back to the feed</a></p>
  </section>

  <section class="block" id="pp-post" style="display:none;max-width:720px;">
    <div class="kicker"><a href="/hub/feed" style="color:inherit;">← Feed</a></div>
    <article class="feed-post" id="pp-article"></article>
  </section>

  <style>
    .feed-post { background: #fff; border: 1px solid rgba(18,26,22,0.08); border-radius: 16px; padding: 18px; }
    .feed-post .meta { font-size: 12.5px; color: var(--stone); }
    .feed-body { font-size: 15px; line-height: 1.6; margin: 8px 0 0; white-space: pre-wrap; word-wrap: break-word; }
    .feed-body a { color: var(--emerald-deep); }
    .media-grid { display: grid; gap: 8px; margin-top: 10px; }
    .media-grid.cols-2 { grid-template-columns: 1fr 1fr; }
    .media-grid img, .media-grid video { width: 100%; border-radius: 10px; display: block; background: #000; }
    .media-grid video { max-height: 420px; }
    .poll-card { border: 1px solid rgba(18,26,22,0.1); border-radius: 12px; padding: 14px; margin-top: 12px; }
    .poll-card h4 { margin: 0 0 6px; font-size: 15px; }
    .poll-card .closes { font-size: 12.5px; color: var(--stone); margin-bottom: 8px; }
    .poll-opt { display: block; width: 100%; text-align: left; margin: 6px 0; padding: 10px 12px; border-radius: 10px; border: 1px solid rgba(18,26,22,0.14); background: #fff; cursor: pointer; font: inherit; }
    .poll-opt:hover { border-color: var(--emerald); }
    .poll-bar { position: relative; margin: 6px 0; border-radius: 10px; background: var(--mint); overflow: hidden; }
    .poll-bar .fill { position: absolute; inset: 0; background: var(--emerald); opacity: 0.25; }
    .poll-bar .lbl { position: relative; display: flex; justify-content: space-between; padding: 10px 12px; font-size: 14px; }
    .poll-bar.mine .lbl { font-weight: 700; }
    .reactbar { display: flex; gap: 6px; margin-top: 12px; flex-wrap: wrap; }
    .reactbar button.react { border: 1px solid rgba(18,26,22,0.12); background: #fff; border-radius: 99px; padding: 6px 12px; font-size: 13px; cursor: pointer; font-family: inherit; }
    .reactbar button.react.on { color: var(--emerald-deep); font-weight: 700; border-color: var(--emerald); }
  </style>

  <script is:inline src="/js/avatar.js"></script>
  <script is:inline src="/js/mentions.js"></script>
  <script is:inline src="/js/share-to-dm.js"></script>
  <script>
    const API_BASE = import.meta.env.PUBLIC_API_BASE || "";
    const POST_ID = new URLSearchParams(window.location.search).get("id") || "";
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s || "").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const api = (p, opts = {}) =>
      fetch(API_BASE + p, { credentials: "include", headers: { accept: "application/json", ...(opts.headers || {}) }, ...opts });
    const show = (id) => {
      ["pp-loading", "pp-login", "pp-missing", "pp-post"].forEach((x) => { $(x).style.display = x === id ? "" : "none"; });
    };
    const REACTS = [
      { kind: "like", icon: "👍", label: "Like" },
      { kind: "celebrate", icon: "🎉", label: "Celebrate" },
      { kind: "insightful", icon: "💡", label: "Insightful" },
      { kind: "support", icon: "🤝", label: "Support" },
    ];

    function relTime(iso) {
      const s = Math.max(1, Math.floor((Date.now() - new Date(iso).getTime()) / 1000));
      if (s < 60) return s + "s";
      if (s < 3600) return Math.floor(s / 60) + "m";
      if (s < 86400) return Math.floor(s / 3600) + "h";
      return Math.floor(s / 86400) + "d";
    }

    function mediaHtml(media) {
      if (!media.length) return "";
      const items = media.map((m) => {
        if (m.kind === "photo") return `<img src="${esc(m.url)}" alt="Post photo" loading="lazy" />`;
        const badge = m.kind === "reel" ? `<span class="reel-badge">Reel</span>` : "";
        return `<div class="media-wrap" style="position:relative;">${badge}<video src="${esc(m.url)}" controls preload="metadata" playsinline></video></div>`;
      }).join("");
      return `<div class="media-grid${media.length > 1 ? " cols-2" : ""}">${items}</div>`;
    }

    function pollHtml(poll) {
      if (!poll) return "";
      const canVote = !poll.closed && !poll.my_vote;
      const opts = poll.options.map((o) => {
        const pct = poll.total_votes ? Math.round((o.votes / poll.total_votes) * 100) : 0;
        if (canVote) return `<button type="button" class="poll-opt" data-opt="${o.id}">${esc(o.label)}</button>`;
        return `<div class="poll-bar${poll.my_vote === o.id ? " mine" : ""}">` +
          `<div class="fill" style="width:${pct}%"></div>` +
          `<div class="lbl"><span>${esc(o.label)}</span><span>${pct}% · ${o.votes}</span></div></div>`;
      }).join("");
      return `<div class="poll-card"><h4>📊 ${esc(poll.question)}</h4>` +
        `<div class="closes">${poll.closed ? "Poll closed" : "Open"} · ${poll.total_votes} vote${poll.total_votes === 1 ? "" : "s"}</div>${opts}</div>`;
    }

    function render(p) {
      const reacts = REACTS.map((r) => {
        const n = (p.reactions && p.reactions.counts && p.reactions.counts[r.kind]) || 0;
        const on = p.reactions && p.reactions.my_reaction === r.kind ? " on" : "";
        return `<button type="button" class="react${on}" data-kind="${r.kind}">${r.icon} ${esc(r.label)}${n ? " " + n : ""}</button>`;
      }).join("");
      $("pp-article").innerHTML =
        `<div style="display:flex;gap:10px;align-items:center;">` +
        `<a href="${esc(p.author.profile_url || "/members")}" style="display:inline-flex;flex:none;text-decoration:none;" aria-label="${esc(p.author.display)}'s profile">${brimwoodAvatar({ src: p.author.avatar_url, name: p.author.display, size: 48 })}</a>` +
        `<div><a href="${esc(p.author.profile_url || "/members")}" style="font-size:15px;font-weight:700;color:inherit;text-decoration:none;">${esc(p.author.display)}</a><br /><span class="meta">${relTime(p.created_at)} · Members</span></div>` +
        `<button type="button" id="pp-share" class="btn btn-ghost btn-sm" style="margin-left:auto;" aria-label="Share post">↗ Share</button></div>` +
        (p.body ? `<p class="feed-body">${Brimwood.renderMentions(p.body)}</p>` : "") +
        mediaHtml(p.media || []) + pollHtml(p.poll) +
        `<div class="reactbar">${reacts}</div>`;
      document.title = `${p.author.display} — Brimwood Innovation`;

      $("pp-article").querySelectorAll(".react").forEach((b) =>
        b.addEventListener("click", async () => {
          const r = await api(`/api/posts/${encodeURIComponent(POST_ID)}/react`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ kind: b.dataset.kind }),
          });
          if (r.ok) load();
        })
      );
      $("pp-article").querySelectorAll(".poll-opt").forEach((b) =>
        b.addEventListener("click", async () => {
          const r = await api(`/api/polls/${encodeURIComponent(p.poll.id)}/vote`, {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ option_id: b.dataset.opt }),
          });
          if (r.ok) load();
        })
      );
      const shareBtn = $("pp-share");
      if (shareBtn && window.Brimwood && window.Brimwood.shareToDM) {
        shareBtn.addEventListener("click", () =>
          window.Brimwood.shareToDM({
            title: `Post by ${p.author.display}`,
            url: `https://brimwoodinnovation.com/hub/post/?id=${encodeURIComponent(POST_ID)}`,
            targetType: "post",
            targetId: POST_ID,
          })
        );
      } else if (shareBtn) {
        shareBtn.addEventListener("click", () => {
          try { navigator.clipboard.writeText(window.location.href); } catch {}
        });
      }
    }

    async function load() {
      if (!POST_ID) return show("pp-missing");
      const r = await api(`/api/posts/${encodeURIComponent(POST_ID)}`);
      if (r.status === 401) return show("pp-login");
      if (!r.ok) return show("pp-missing");
      const d = await r.json();
      if (!d.ok || !d.post) return show("pp-missing");
      render(d.post);
      show("pp-post");
    }
    load();
  </script>
</Base>
