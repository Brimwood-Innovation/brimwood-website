---
/* Wall of builders (Phase B): public testimonials wall, featured first.
 * Members are anonymous by default — attributions use initials + role only. */
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const testimonials = (await getCollection("testimonials")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<Base
  title="Wall of builders — Brimwood Innovation"
  description="What members say about building at Brimwood Innovation. Anonymous by default, honest by standard."
  path="/wall"
>
  <section class="block">
    <div class="kicker">Wall of builders</div>
    <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">In their words.</h1>
    <p class="sec-lede">Members are anonymous by default. What matters is the work, not the name.</p>
    <div class="cards" style="grid-template-columns:repeat(3,1fr);">
      {testimonials.map((t) => (
        <figure class="card" style="margin:0;display:flex;flex-direction:column;">
          {t.data.featured && <div class="n">Featured</div>}
          <blockquote style="margin:0 0 16px;font-size:17px;line-height:1.6;flex:1;">
            &ldquo;{t.data.quote}&rdquo;
          </blockquote>
          <figcaption>
            <div style="font-weight:700;font-size:14px;">{t.data.attribution}</div>
            {t.data.role && <div style="font-size:13px;color:var(--stone);">{t.data.role}</div>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</Base>
