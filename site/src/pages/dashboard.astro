---
/* Member dashboard: enrolled courses, progress bars, continue learning.
 * Certificates: a completed course shows its certificate link plus a
 * visibility switch (private, link, public) wired to the existing
 * PATCH /api/certificates/:id/visibility endpoint. The card is an article,
 * not a link, so the select stays a real control for keyboard users. */
import Base from "../layouts/Base.astro";
import HubShell from "../components/HubShell.astro";
---

<Base title="Dashboard - Brimwood Innovation" description="Your learning progress.">
  <HubShell current="academy">
  <section class="block">
    <div id="dash-loading"><p class="sec-lede">Loading…</p></div>

    <div id="dash-login" style="display:none;text-align:center;padding:48px 0;">
      <div class="kicker">Members</div>
      <h2 class="sec">Sign in to see your dashboard.</h2>
      <p class="sec-lede" style="margin-inline:auto;"><a href="/members">Sign in</a> to track your progress.</p>
    </div>

    <div id="dash-home" style="display:none;">
      <div class="kicker">Dashboard</div>
      <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">Keep shipping.</h1>
      <p class="sec-lede" id="dashSub"></p>
      <div class="cards" style="grid-template-columns:repeat(2,1fr);" id="courseList"></div>
      <p style="margin-top:32px;"><a href="/academy">Browse all courses →</a> <span style="margin:0 8px;">·</span> <a href="/members/profile">Edit your profile →</a></p>
    </div>
  </section>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_BASE || "";
    const show = (id) => (document.getElementById(id).style.display = "block");
    const hide = (id) => (document.getElementById(id).style.display = "none");
    // Canonical escaper: window.Brimwood.escapeHtml (site/public/js/escape.js), loaded by Base before this script.
    // One full escaper covers both text and attribute values now, so escAttr is the same function.
    const esc = window.Brimwood.escapeHtml;
    const escAttr = window.Brimwood.escapeHtml;
    const VIS_OPTIONS = [["private", "Private"], ["link", "Link"], ["public", "Public"]];

    /* Certificate block for one enrolment: the link on its own when the
     * member list is unavailable, plus the visibility switch when the
     * matching valid certificate is known. Only valid certificates get
     * a switch, matching the endpoint's valid-only rule. */
    const certBlock = (e, idx, certByCode) => {
      if (!e.certificate_code) return "";
      const link = `<p><a href="/c/${escAttr(e.certificate_code)}">Certificate ${esc(e.certificate_code)} →</a></p>`;
      const cert = certByCode[e.certificate_code];
      if (!cert) return link;
      const sid = `cert-vis-${idx}`;
      const opts = VIS_OPTIONS.map(([v, l]) => `<option value="${v}"${v === cert.visibility ? " selected" : ""}>${l}</option>`).join("");
      return link +
        `<div style="margin-top:12px;"><label for="${sid}">Certificate visibility</label>` +
        `<select id="${sid}" data-cert-id="${escAttr(cert.id)}" data-prev="${escAttr(cert.visibility)}" aria-label="Certificate visibility for ${escAttr(e.title)}">${opts}</select>` +
        `<p class="admin-muted" id="${sid}-msg" role="status" style="font-size:13px;"></p>` +
        `<p class="admin-muted" style="font-size:13px;">Private hides the details; link and public show them to anyone who opens the certificate page.</p></div>`;
    };

    (async () => {
      try {
        const r = await fetch(API_BASE + "/api/progress", {
          headers: { accept: "application/json" },
          credentials: "include",
        });
        const d = await r.json();
        if (!r.ok || !d.ok) throw 0;

        hide("dash-loading");
        const list = d.enrolments || [];
        show("dash-home");

        /* The member certificate list is best effort: if it fails, the
         * cards still render with the certificate link and no switch. */
        let certByCode = {};
        try {
          const cr = await fetch(API_BASE + "/api/certificates/mine", {
            headers: { accept: "application/json" },
            credentials: "include",
          });
          const cd = await cr.json();
          if (cr.ok && cd.ok) {
            for (const cert of cd.certificates || []) {
              if (cert.status === "valid") certByCode[cert.code] = cert;
            }
          }
        } catch {
          certByCode = {};
        }

        if (list.length === 0) {
          document.getElementById("dashSub").textContent = "You're not enrolled in anything yet. Pick a course to get started.";
          return;
        }

        const total = list.length;
        const done = list.filter((e) => e.completed).length;
        document.getElementById("dashSub").textContent =
          `Enrolled in ${total} course${total === 1 ? "" : "s"}${done ? ` · ${done} completed` : ""}.`;

        document.getElementById("courseList").innerHTML = list
          .map((e, idx) => {
            const pct = e.total_lessons ? Math.round((e.done_lessons / e.total_lessons) * 100) : 0;
            return (
              `<article class="card">` +
              `<div class="n">${e.done_lessons}/${e.total_lessons} lessons</div>` +
              `<h3><a href="/academy/${escAttr(e.slug)}" style="text-decoration:none;">${esc(e.title)}</a></h3>` +
              `<div style="height:8px;background:var(--mint);border-radius:4px;overflow:hidden;margin:12px 0;">` +
              `<div style="height:100%;width:${pct}%;background:var(--emerald);border-radius:4px;"></div></div>` +
              `<p><a href="/academy/${escAttr(e.slug)}" style="text-decoration:none;">${e.completed ? "Completed ✓" : pct === 0 ? "Start →" : "Continue →"}</a></p>` +
              certBlock(e, idx, certByCode) + `</article>`
            );
          })
          .join("");

        /* Wire every switch: save through the endpoint, revert on failure
         * so the control never shows a visibility the server rejected. */
        document.querySelectorAll("#courseList select[data-cert-id]").forEach((sel) => {
          sel.addEventListener("change", async () => {
            const next = sel.value;
            const prev = sel.dataset.prev;
            const msg = document.getElementById(sel.id + "-msg");
            sel.disabled = true;
            if (msg) msg.textContent = "Saving…";
            try {
              const r = await fetch(API_BASE + "/api/certificates/" + encodeURIComponent(sel.dataset.certId) + "/visibility", {
                method: "PATCH",
                headers: { "content-type": "application/json", accept: "application/json" },
                credentials: "include",
                body: JSON.stringify({ visibility: next }),
              });
              const dd = await r.json().catch(() => ({}));
              if (!r.ok || !dd.ok) throw 0;
              sel.dataset.prev = next;
              if (msg) msg.textContent = "Visibility saved.";
            } catch {
              sel.value = prev;
              if (msg) msg.textContent = "Could not save. Try again.";
            } finally {
              sel.disabled = false;
            }
          });
        });
      } catch {
        hide("dash-loading");
        show("dash-login");
      }
    })();
  </script>
  </HubShell>
</Base>
