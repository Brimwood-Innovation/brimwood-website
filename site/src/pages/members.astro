---
/* Members shell (T19): auth-gated. Client-side session check against
 * /api/auth/me; anonymous visitors see the sign-in form. */
import Base from "../layouts/Base.astro";
import StoriesTray from "../components/StoriesTray.astro";
---

<Base
  title="Members - Brimwood Innovation"
  description="The Brimwood members area. Sign in with your email or a passkey to continue."
  path="/members"
>
  <section class="block" id="members-loading">
    <div class="kicker">Members</div>
    <p class="sec-lede">Checking your session…</p>
  </section>

  <section class="block" id="members-login" style="display:none">
    <div class="kicker">Members</div>
    <h1 class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:18px;">Sign in.</h1>
    <p class="sec-lede">Enter your email and we will send a 6-digit code. No passwords.</p>
    <div class="cta" style="margin-top:0;max-width:560px;margin-inline:auto;">
      <form class="intro" id="loginForm" style="margin:0 auto;">
        <label for="lEmail">Email</label>
        <input id="lEmail" type="email" placeholder="you@example.com" required />
        <button class="btn" type="submit" id="loginBtn">Send code</button>
        <p class="form-err" id="loginErr" style="display:none"></p>
      </form>
      <form class="intro" id="codeForm" style="display:none;margin:0 auto;">
        <p style="margin-bottom:8px;">We sent a code to <strong id="codeEmail"></strong>.</p>
        <label for="lCode">6-digit code</label>
        <input id="lCode" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="123456" required />
        <button class="btn" type="submit" id="codeBtn">Sign in</button>
        <p class="form-err" id="codeErr" style="display:none"></p>
      </form>
      <div id="pkSigninWrap" style="display:none;margin-top:24px;border-top:1px solid rgba(18,26,22,.12);padding-top:24px;">
        <button class="btn btn-ghost" type="button" id="pkSigninBtn" style="width:100%;">Sign in with a passkey</button>
        <p class="form-err" id="pkSigninErr" style="display:none"></p>
        <p style="margin-top:12px;font-size:14px;">No passkey yet? Sign in with a code, then add one below.</p>
      </div>
    </div>
  </section>

  <section class="block" id="members-home" style="display:none">
    <div class="kicker">Members</div>
    <h1 class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:18px;">
      Welcome<span id="memberName"></span>.
    </h1>
    <p class="sec-lede">Your Brimwood home base.</p>
    <StoriesTray />
    <div class="cards" style="grid-template-columns:repeat(2,1fr);">
      <div class="card"><div class="n">ROLE</div><h3 id="memberRole">-</h3><p>Your membership role.</p></div>
      <div class="card"><div class="n">EMAIL</div><h3 id="memberEmail" style="font-size:15px;word-break:break-all;">-</h3><p>Signed in as.</p></div>
    </div>
    <div id="pkManage" style="display:none;margin-top:32px;">
      <h2 class="sec" style="font-size:22px;margin-bottom:12px;">Passkeys</h2>
      <p class="sec-lede" id="pkEmpty">No passkeys yet. Add one to sign in without a code.</p>
      <ul id="pkList" style="list-style:none;padding:0;margin:0;"></ul>
      <p style="margin-top:16px;display:flex;gap:12px;flex-wrap:wrap;">
        <button class="btn btn-ghost" type="button" id="pkAddBtn">Add a passkey</button>
      </p>
      <p class="form-err" id="pkErr" style="display:none"></p>
      <p role="status" id="pkOk" style="display:none;"></p>
    </div>
    <p style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap;">
      <a class="btn" href="/dashboard">Go to dashboard →</a>
      <a class="btn btn-ghost" href="/hub/messages">Messages</a>
      <a class="btn btn-ghost" href="/academy">Browse academy</a>
      <a class="btn btn-ghost" href="/admin" id="adminLink" style="display:none;">Admin panel</a>
      <button class="btn btn-ghost" id="logoutBtn">Sign out</button>
    </p>
  </section>

  <script>
    // --- members auth shell (vanilla; talks to /api/auth/*) ---
    const show = (id) => { document.getElementById(id).style.display = ''; };
    const hide = (id) => { document.getElementById(id).style.display = 'none'; };
    const err = (id, msg) => {
      const e = document.getElementById(id);
      e.textContent = msg; e.style.display = 'block';
    };
    const API_BASE = import.meta.env.PUBLIC_API_BASE || '';
    const withCreds = { credentials: 'include' };

    async function checkSession() {
      try {
        const r = await fetch(API_BASE + '/api/auth/me', { headers: { accept: 'application/json' }, ...withCreds });
        if (!r.ok) throw 0;
        const d = await r.json();
        if (!d.ok) throw 0;
        hide('members-loading'); hide('members-login'); show('members-home');
        document.getElementById('memberName').textContent = d.user.name ? ', ' + d.user.name : '';
        document.getElementById('memberRole').textContent = d.user.role;
        document.getElementById('memberEmail').textContent = d.user.email;
        if (d.user.role === 'admin') document.getElementById('adminLink').style.display = '';
        if (pkSupported) { show('pkManage'); loadPasskeys(); }
      } catch {
        hide('members-loading'); show('members-login'); hide('members-home');
        if (pkSupported) show('pkSigninWrap');
      }
    }

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('lEmail').value.trim();
      const btn = document.getElementById('loginBtn');
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const r = await fetch(API_BASE + '/api/auth/request-code', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ email }),
          ...withCreds,
        });
        if (!r.ok) throw new Error('request failed');
        document.getElementById('codeEmail').textContent = email;
        hide('loginForm'); show('codeForm');
        document.getElementById('lCode').focus();
      } catch {
        err('loginErr', 'Could not send the code. Please try again.');
        btn.disabled = false; btn.textContent = 'Send code';
      }
    });

    document.getElementById('codeForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('lEmail').value.trim();
      const code = document.getElementById('lCode').value.trim();
      const btn = document.getElementById('codeBtn');
      btn.disabled = true; btn.textContent = 'Signing in…';
      try {
        const r = await fetch(API_BASE + '/api/auth/verify-code', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ email, code }),
          ...withCreds,
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || !d.ok) throw new Error(d.error || 'invalid code');
        location.reload();
      } catch (ex) {
        err('codeErr', ex.message || 'Invalid code.');
        btn.disabled = false; btn.textContent = 'Sign in';
      }
    });

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      await fetch(API_BASE + '/api/auth/logout', { method: 'POST', ...withCreds });
      location.reload();
    });

    // --- passkeys (Phase 3 slice 1; talks to /api/passkeys/*) ---
    const pkSupported = typeof window !== 'undefined' && !!window.PublicKeyCredential;
    const b64ToBuf = (s) => {
      const bin = atob(s.replace(/-/g, '+').replace(/_/g, '/'));
      const b = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) b[i] = bin.charCodeAt(i);
      return b.buffer;
    };
    const bufToB64 = (buf) => {
      const bytes = new Uint8Array(buf);
      let bin = '';
      bytes.forEach((b) => { bin += String.fromCharCode(b); });
      return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    };
    const pkOk = (msg) => {
      const e = document.getElementById('pkOk');
      e.textContent = msg; e.style.display = 'block';
      document.getElementById('pkErr').style.display = 'none';
    };

    async function signInWithPasskey() {
      const btn = document.getElementById('pkSigninBtn');
      btn.disabled = true; btn.textContent = 'Waiting for your passkey…';
      try {
        const o = await fetch(API_BASE + '/api/passkeys/authenticate/options', {
          method: 'POST', headers: { accept: 'application/json' }, ...withCreds,
        });
        const d = await o.json();
        if (!o.ok || !d.ok) throw new Error('Could not start passkey sign-in.');
        const cred = await navigator.credentials.get({
          publicKey: {
            challenge: b64ToBuf(d.options.challenge),
            timeout: d.options.timeout,
            rpId: d.options.rpId,
            userVerification: d.options.userVerification,
          },
        });
        if (!cred) throw new Error('No passkey selected.');
        if (!cred.response.userHandle) throw new Error('This passkey did not identify its owner.');
        const r = await fetch(API_BASE + '/api/passkeys/authenticate/verify', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            id: cred.id, rawId: cred.id, type: cred.type,
            response: {
              clientDataJSON: bufToB64(cred.response.clientDataJSON),
              authenticatorData: bufToB64(cred.response.authenticatorData),
              signature: bufToB64(cred.response.signature),
              userHandle: bufToB64(cred.response.userHandle),
            },
          }),
          ...withCreds,
        });
        const v = await r.json().catch(() => ({}));
        if (!r.ok || !v.ok) throw new Error(v.error || 'Passkey sign-in failed.');
        location.reload();
      } catch (ex) {
        const msg = ex && ex.name === 'NotAllowedError'
          ? 'Passkey sign-in was cancelled.'
          : (ex.message || 'Passkey sign-in failed.');
        err('pkSigninErr', msg);
        btn.disabled = false; btn.textContent = 'Sign in with a passkey';
      }
    }

    async function loadPasskeys() {
      try {
        const r = await fetch(API_BASE + '/api/passkeys', { headers: { accept: 'application/json' }, ...withCreds });
        const d = await r.json();
        if (!r.ok || !d.ok) throw 0;
        const list = document.getElementById('pkList');
        list.innerHTML = '';
        document.getElementById('pkEmpty').style.display = d.credentials.length ? 'none' : '';
        d.credentials.forEach((c) => {
          const li = document.createElement('li');
          li.style.cssText = 'display:flex;gap:12px;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid rgba(18,26,22,.12);';
          const label = document.createElement('span');
          const added = new Date(c.createdAt).toLocaleDateString();
          label.textContent = (c.nickname || 'Passkey') + ' · added ' + added +
            (c.lastUsedAt ? ' · last used ' + new Date(c.lastUsedAt).toLocaleDateString() : '');
          const rm = document.createElement('button');
          rm.className = 'btn btn-ghost';
          rm.type = 'button';
          rm.textContent = 'Remove';
          rm.addEventListener('click', async () => {
            if (!confirm('Remove this passkey?')) return;
            const del = await fetch(API_BASE + '/api/passkeys/' + encodeURIComponent(c.id), {
              method: 'DELETE', ...withCreds,
            });
            const dd = await del.json().catch(() => ({}));
            if (!del.ok || !dd.ok) { err('pkErr', dd.error || 'Could not remove that passkey.'); return; }
            pkOk('Passkey removed.');
            loadPasskeys();
          });
          li.appendChild(label);
          li.appendChild(rm);
          list.appendChild(li);
        });
      } catch {
        /* Leave the empty state; the list simply stays blank. */
      }
    }

    async function addPasskey() {
      const btn = document.getElementById('pkAddBtn');
      btn.disabled = true; btn.textContent = 'Waiting for your passkey…';
      try {
        const o = await fetch(API_BASE + '/api/passkeys/register/options', {
          method: 'POST', headers: { accept: 'application/json' }, ...withCreds,
        });
        const d = await o.json();
        if (!o.ok || !d.ok) throw new Error('Could not start passkey setup.');
        const cred = await navigator.credentials.create({
          publicKey: {
            rp: d.options.rp,
            user: {
              id: b64ToBuf(d.options.user.id),
              name: d.options.user.name,
              displayName: d.options.user.displayName,
            },
            challenge: b64ToBuf(d.options.challenge),
            pubKeyCredParams: d.options.pubKeyCredParams,
            timeout: d.options.timeout,
            attestation: d.options.attestation,
            authenticatorSelection: d.options.authenticatorSelection,
            excludeCredentials: (d.options.excludeCredentials || []).map((e) => ({
              type: e.type, id: b64ToBuf(e.id),
            })),
          },
        });
        if (!cred) throw new Error('No passkey created.');
        const r = await fetch(API_BASE + '/api/passkeys/register/verify', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            id: cred.id, rawId: cred.id, type: cred.type,
            response: {
              clientDataJSON: bufToB64(cred.response.clientDataJSON),
              attestationObject: bufToB64(cred.response.attestationObject),
              transports: cred.response.getTransports ? cred.response.getTransports() : [],
            },
          }),
          ...withCreds,
        });
        const v = await r.json().catch(() => ({}));
        if (!r.ok || !v.ok) throw new Error(v.error || 'Could not save that passkey.');
        pkOk('Passkey added. You can sign in with it next time.');
        loadPasskeys();
      } catch (ex) {
        const msg = ex && ex.name === 'NotAllowedError'
          ? 'Passkey setup was cancelled.'
          : (ex.message || 'Could not save that passkey.');
        err('pkErr', msg);
      }
      btn.disabled = false; btn.textContent = 'Add a passkey';
    }

    if (pkSupported) {
      document.getElementById('pkSigninBtn').addEventListener('click', signInWithPasskey);
      document.getElementById('pkAddBtn').addEventListener('click', addPasskey);
    }

    checkSession();
  </script>
</Base>
