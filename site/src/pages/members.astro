---
/* Members shell (T19): auth-gated. Client-side session check against
 * /api/auth/me; anonymous visitors see the sign-in form. */
import Base from "../layouts/Base.astro";
---

<Base
  title="Members — Brimwood Innovation"
  description="The Brimwood members area. Sign in with your email to continue."
  path="/members"
>
  <section class="block" id="members-loading">
    <div class="kicker">Members</div>
    <p class="sec-lede">Checking your session…</p>
  </section>

  <section class="block" id="members-login" style="display:none">
    <div class="kicker">Members</div>
    <h1 class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:18px;">Sign in.</h1>
    <p class="sec-lede">Enter your email and we will send a 6-digit code. No passwords.</p>
    <div class="cta" style="margin-top:0;max-width:560px;margin-inline:auto;">
      <form class="intro" id="loginForm" style="margin:0 auto;">
        <label for="lEmail">Email</label>
        <input id="lEmail" type="email" placeholder="you@example.com" required />
        <button class="btn" type="submit" id="loginBtn">Send code</button>
        <p class="form-err" id="loginErr" style="display:none"></p>
      </form>
      <form class="intro" id="codeForm" style="display:none;margin:0 auto;">
        <p style="margin-bottom:8px;">We sent a code to <strong id="codeEmail"></strong>.</p>
        <label for="lCode">6-digit code</label>
        <input id="lCode" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="6" placeholder="123456" required />
        <button class="btn" type="submit" id="codeBtn">Sign in</button>
        <p class="form-err" id="codeErr" style="display:none"></p>
      </form>
    </div>
  </section>

  <section class="block" id="members-home" style="display:none">
    <div class="kicker">Members</div>
    <h1 class="sec" style="font-size:clamp(28px,4vw,40px);margin-bottom:18px;">
      Welcome<span id="memberName"></span>.
    </h1>
    <p class="sec-lede">Your Brimwood home base.</p>
    <div class="cards" style="grid-template-columns:repeat(2,1fr);">
      <div class="card"><div class="n">ROLE</div><h3 id="memberRole">—</h3><p>Your membership role.</p></div>
      <div class="card"><div class="n">EMAIL</div><h3 id="memberEmail" style="font-size:15px;word-break:break-all;">—</h3><p>Signed in as.</p></div>
    </div>
    <p style="margin-top:32px;display:flex;gap:12px;flex-wrap:wrap;">
      <a class="btn" href="/dashboard">Go to dashboard →</a>
      <a class="btn btn-ghost" href="/academy">Browse academy</a>
      <a class="btn btn-ghost" href="/admin" id="adminLink" style="display:none;">Admin panel</a>
      <button class="btn btn-ghost" id="logoutBtn">Sign out</button>
    </p>
  </section>

  <script>
    // --- members auth shell (vanilla; talks to /api/auth/*) ---
    const show = (id) => { document.getElementById(id).style.display = ''; };
    const hide = (id) => { document.getElementById(id).style.display = 'none'; };
    const err = (id, msg) => {
      const e = document.getElementById(id);
      e.textContent = msg; e.style.display = 'block';
    };
    const API_BASE = import.meta.env.PUBLIC_API_BASE || '';
    const withCreds = { credentials: 'include' };

    async function checkSession() {
      try {
        const r = await fetch(API_BASE + '/api/auth/me', { headers: { accept: 'application/json' }, ...withCreds });
        if (!r.ok) throw 0;
        const d = await r.json();
        if (!d.ok) throw 0;
        hide('members-loading'); hide('members-login'); show('members-home');
        document.getElementById('memberName').textContent = d.user.name ? ', ' + d.user.name : '';
        document.getElementById('memberRole').textContent = d.user.role;
        document.getElementById('memberEmail').textContent = d.user.email;
        if (d.user.role === 'admin') document.getElementById('adminLink').style.display = '';
      } catch {
        hide('members-loading'); show('members-login'); hide('members-home');
      }
    }

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('lEmail').value.trim();
      const btn = document.getElementById('loginBtn');
      btn.disabled = true; btn.textContent = 'Sending…';
      try {
        const r = await fetch(API_BASE + '/api/auth/request-code', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ email }),
          ...withCreds,
        });
        if (!r.ok) throw new Error('request failed');
        document.getElementById('codeEmail').textContent = email;
        hide('loginForm'); show('codeForm');
        document.getElementById('lCode').focus();
      } catch {
        err('loginErr', 'Could not send the code. Please try again.');
        btn.disabled = false; btn.textContent = 'Send code';
      }
    });

    document.getElementById('codeForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('lEmail').value.trim();
      const code = document.getElementById('lCode').value.trim();
      const btn = document.getElementById('codeBtn');
      btn.disabled = true; btn.textContent = 'Signing in…';
      try {
        const r = await fetch(API_BASE + '/api/auth/verify-code', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({ email, code }),
          ...withCreds,
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || !d.ok) throw new Error(d.error || 'invalid code');
        location.reload();
      } catch (ex) {
        err('codeErr', ex.message || 'Invalid code.');
        btn.disabled = false; btn.textContent = 'Sign in';
      }
    });

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      await fetch(API_BASE + '/api/auth/logout', { method: 'POST', ...withCreds });
      location.reload();
    });

    checkSession();
  </script>
</Base>
