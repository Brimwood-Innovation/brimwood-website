---
/* Member profile editor (Phase D2): username handle, display name, bio,
 * avatar, location, website, socials, work history, education, hobbies,
 * and the public opt-in. Brand rule: anonymous by default. */
import Base from "../../layouts/Base.astro";
---

<Base title="Your profile — Brimwood Innovation" description="Edit your member profile.">
  <section class="block">
    <div id="prof-loading"><p class="sec-lede">Loading…</p></div>

    <div id="prof-login" style="display:none;text-align:center;padding:48px 0;">
      <div class="kicker">Members</div>
      <h2 class="sec">Sign in to edit your profile.</h2>
      <p class="sec-lede" style="margin-inline:auto;"><a href="/members">Sign in</a> first.</p>
    </div>

    <div id="prof-home" style="display:none;max-width:640px;">
      <div class="kicker">Members</div>
      <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">Your profile</h1>
      <p class="sec-lede">You appear as <strong id="publicName"></strong> on public pages. Your email and real name are never shown publicly.</p>

      <div style="margin:32px 0;">
        <img id="avatarImg" alt="Your avatar" style="width:96px;height:96px;border-radius:50%;object-fit:cover;display:none;" />
        <p style="margin-top:12px;">
          <label for="avatarFile" class="btn btn-ghost small" style="cursor:pointer;">Upload avatar</label>
          <input id="avatarFile" type="file" accept="image/png,image/jpeg,image/webp,image/gif" style="display:none;" />
        </p>
        <p class="admin-muted" id="avatarMsg" style="font-size:13px;"></p>
      </div>

      <form id="profForm">
        <label for="fUsername">Username</label>
        <div style="display:flex;gap:8px;align-items:center;">
          <span class="admin-muted">@</span>
          <input id="fUsername" type="text" minlength="3" maxlength="30" pattern="[a-z][a-z0-9_]{2,29}" placeholder="jane_builds" style="flex:1;" />
        </div>
        <p class="admin-muted" style="font-size:13px;" id="usernameHint">3–30 chars, lowercase letters, numbers, underscores. Your shareable page: <span id="usernameUrl"></span></p>

        <label for="fDisplay" style="margin-top:16px;display:block;">Display name</label>
        <input id="fDisplay" type="text" minlength="2" maxlength="40" placeholder="J." style="width:100%;" />

        <label for="fBio" style="margin-top:16px;display:block;">Bio</label>
        <textarea id="fBio" rows="3" maxlength="500" placeholder="A line or two about what you're building." style="width:100%;"></textarea>
        <p class="admin-muted" style="font-size:13px;"><span id="bioCount">0</span>/500</p>

        <label for="fLocation" style="margin-top:16px;display:block;">Location</label>
        <input id="fLocation" type="text" maxlength="100" placeholder="Toronto, ON" style="width:100%;" />

        <label for="fWebsite" style="margin-top:16px;display:block;">Website</label>
        <input id="fWebsite" type="url" maxlength="300" placeholder="https://…" style="width:100%;" />

        <label for="fHobbies" style="margin-top:16px;display:block;">Hobbies</label>
        <input id="fHobbies" type="text" maxlength="500" placeholder="What you do for fun." style="width:100%;" />

        <h3 class="sec" style="font-size:22px;margin-top:32px;">Social links</h3>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div><label for="sGithub" style="font-size:13px;">GitHub</label><input id="sGithub" type="url" placeholder="https://github.com/…" style="width:100%;" /></div>
          <div><label for="sLinkedin" style="font-size:13px;">LinkedIn</label><input id="sLinkedin" type="url" placeholder="https://linkedin.com/in/…" style="width:100%;" /></div>
          <div><label for="sX" style="font-size:13px;">X</label><input id="sX" type="url" placeholder="https://x.com/…" style="width:100%;" /></div>
          <div><label for="sInstagram" style="font-size:13px;">Instagram</label><input id="sInstagram" type="url" placeholder="https://instagram.com/…" style="width:100%;" /></div>
        </div>

        <h3 class="sec" style="font-size:22px;margin-top:32px;">Work history</h3>
        <div id="workList"></div>
        <p><button type="button" class="btn btn-ghost small" id="addWork">+ Add role</button></p>

        <h3 class="sec" style="font-size:22px;margin-top:32px;">Education</h3>
        <div id="eduList"></div>
        <p><button type="button" class="btn btn-ghost small" id="addEdu">+ Add education</button></p>

        <label style="margin-top:32px;display:flex;gap:10px;align-items:flex-start;cursor:pointer;">
          <input id="fPublic" type="checkbox" style="margin-top:4px;" />
          <span><strong>Make my profile public.</strong><br />
          <span class="admin-muted" style="font-size:13px;">Anyone can see your display name, bio, avatar, and portfolio at your public page. Off by default — you stay anonymous.</span></span>
        </label>

        <p style="margin-top:24px;">
          <button class="btn" type="submit" id="saveBtn">Save profile</button>
          <span class="admin-muted" id="saveMsg" style="margin-left:12px;font-size:14px;"></span>
        </p>
      </form>

      <p id="publicLinkWrap" style="display:none;margin-top:16px;">
        <a id="publicLink" href="#">View your public profile →</a>
      </p>
    </div>
  </section>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_BASE || "";
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const api = (p, opts = {}) =>
      fetch(API_BASE + p, { credentials: "include", headers: { accept: "application/json", ...(opts.headers || {}) }, ...opts });

    let myId = null;

    function entryRow(kind, data) {
      data = data || {};
      const div = document.createElement("div");
      div.className = "entry-row";
      div.style.cssText = "display:grid;grid-template-columns:1fr 1fr auto;gap:8px;margin-bottom:8px;";
      const aLabel = kind === "work" ? "Title" : "School";
      const bLabel = kind === "work" ? "Company" : "Degree";
      div.innerHTML =
        '<input data-k="a" placeholder="' + aLabel + '" maxlength="100" value="' + esc(data.title || data.school || "") + '">' +
        '<input data-k="b" placeholder="' + bLabel + '" maxlength="100" value="' + esc(data.company || data.degree || "") + '">' +
        '<input data-k="period" placeholder="2022–now" maxlength="60" value="' + esc(data.period || "") + '">' +
        '<button type="button" class="btn btn-ghost small entry-del" style="grid-column:1/-1;justify-self:start;">Remove</button>';
      div.querySelector(".entry-del").addEventListener("click", () => div.remove());
      return div;
    }
    function collectEntries(listId, kind) {
      const out = [];
      document.querySelectorAll("#" + listId + " .entry-row").forEach((row) => {
        const a = row.querySelector('[data-k="a"]').value.trim();
        const b = row.querySelector('[data-k="b"]').value.trim();
        const period = row.querySelector('[data-k="period"]').value.trim();
        if (!a && !b) return;
        out.push(kind === "work" ? { title: a, company: b, period } : { school: a, degree: b, period });
      });
      return out;
    }

    $("addWork").addEventListener("click", () => $("workList").appendChild(entryRow("work")));
    $("addEdu").addEventListener("click", () => $("eduList").appendChild(entryRow("edu")));

    function parseJson(s, fallback) {
      try { return s ? JSON.parse(s) : fallback; } catch (e) { return fallback; }
    }

    async function load() {
      try {
        const r = await api("/api/users/me");
        const d = await r.json();
        if (!r.ok || !d.ok) throw 0;
        const u = d.user;
        myId = u.id;
        $("prof-loading").style.display = "none";
        $("prof-home").style.display = "block";
        $("fUsername").value = u.username || "";
        $("fDisplay").value = u.display_name || "";
        $("fBio").value = u.bio || "";
        $("fLocation").value = u.location || "";
        $("fWebsite").value = u.website || "";
        $("fHobbies").value = u.hobbies || "";
        $("fPublic").checked = u.show_profile === 1;
        $("publicName").textContent = u.display_name_public || "Member";
        const social = parseJson(u.social_links, {});
        $("sGithub").value = social.github || "";
        $("sLinkedin").value = social.linkedin || "";
        $("sX").value = social.x || social.twitter || "";
        $("sInstagram").value = social.instagram || "";
        parseJson(u.work_history, []).forEach((e) => $("workList").appendChild(entryRow("work", e)));
        parseJson(u.education, []).forEach((e) => $("eduList").appendChild(entryRow("edu", e)));
        updateBioCount();
        updateUsernameHint();
        if (u.avatar_url) {
          $("avatarImg").src = u.avatar_url;
          $("avatarImg").style.display = "block";
        }
        if (u.show_profile === 1) showPublicLink(u);
      } catch (e) {
        $("prof-loading").style.display = "none";
        $("prof-login").style.display = "block";
      }
    }

    function showPublicLink(u) {
      $("publicLinkWrap").style.display = "block";
      const href = u.username ? "/@" + encodeURIComponent(u.username) : "/u/" + encodeURIComponent(u.id);
      $("publicLink").href = href;
    }

    function updateBioCount() { $("bioCount").textContent = $("fBio").value.length; }
    $("fBio").addEventListener("input", updateBioCount);
    function updateUsernameHint() {
      const v = $("fUsername").value.trim().toLowerCase();
      $("usernameUrl").textContent = v ? location.origin + "/@" + v : "(claim a username first)";
    }
    $("fUsername").addEventListener("input", updateUsernameHint);

    $("profForm").addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = $("saveBtn"), msg = $("saveMsg");
      btn.disabled = true;
      msg.textContent = "Saving…";
      try {
        const social = {};
        const sg = $("sGithub").value.trim(); if (sg) social.github = sg;
        const sl = $("sLinkedin").value.trim(); if (sl) social.linkedin = sl;
        const sx = $("sX").value.trim(); if (sx) social.x = sx;
        const si = $("sInstagram").value.trim(); if (si) social.instagram = si;
        const r = await api("/api/users/me", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            username: $("fUsername").value.trim().toLowerCase(),
            display_name: $("fDisplay").value.trim(),
            bio: $("fBio").value.trim(),
            location: $("fLocation").value.trim(),
            website: $("fWebsite").value.trim(),
            hobbies: $("fHobbies").value.trim(),
            social_links: social,
            work_history: collectEntries("workList", "work"),
            education: collectEntries("eduList", "edu"),
            show_profile: $("fPublic").checked ? 1 : 0,
          }),
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || !d.ok) throw new Error(d.error || "Save failed.");
        msg.textContent = "Saved.";
        $("publicName").textContent = $("fDisplay").value.trim() || "Member";
        if ($("fPublic").checked && myId) {
          showPublicLink({ id: myId, username: $("fUsername").value.trim().toLowerCase() || null });
        } else {
          $("publicLinkWrap").style.display = "none";
        }
        updateUsernameHint();
      } catch (ex) {
        msg.textContent = ex.message || "Something went wrong.";
      } finally {
        btn.disabled = false;
      }
    });

    $("avatarFile").addEventListener("change", async (e) => {
      const f = e.target.files[0];
      if (!f) return;
      const msg = $("avatarMsg");
      msg.textContent = "Uploading…";
      try {
        const fd = new FormData();
        fd.append("file", f);
        const r = await api("/api/users/me/avatar", { method: "POST", body: fd });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || !d.ok) throw new Error(d.error || "Upload failed.");
        $("avatarImg").src = d.avatar_url;
        $("avatarImg").style.display = "block";
        msg.textContent = "Avatar updated.";
      } catch (ex) {
        msg.textContent = ex.message || "Something went wrong.";
      }
    });

    load();
  </script>
</Base>
