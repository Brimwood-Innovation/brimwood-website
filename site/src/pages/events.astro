---
/* Events index: upcoming demo nights and gatherings.
 * Client-rendered so new events appear without a rebuild.
 * Phase 2 slice 3: ported from prototype section 06 (v5 UX deck). The
 * deck header is Events, with the line that demo nights are at 1365
 * Gerrard St E and visitors come only with a guest pass from a member.
 * Cards follow the deck card model: name, when line, seats taken, and a
 * View event button; a full event says Full, with no waitlist. Events
 * still render from GET /api/events, the same source as before. Times
 * show in America/Toronto (the stored zone, R5). */
import Base from "../layouts/Base.astro";
---

<Base
  title="Events — Brimwood Innovation"
  description="Demo nights and gatherings at 1365 Gerrard St E, Toronto. Visitors come only with a guest pass from a member."
  path="/events"
  jsonld={{
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://brimwoodinnovation.com/" },
      { "@type": "ListItem", position: 2, name: "Events", item: "https://brimwoodinnovation.com/events" },
    ],
  }}
>
  <section class="block events-ui">
    <div class="kicker">Events</div>
    <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">Events</h1>
    <p class="sec-lede">
      Demo nights at 1365 Gerrard St E. Visitors come only with a guest pass from a member.
    </p>
  </section>

  <section class="block events-ui">
    <div id="eventsList"><p class="sec-lede">Loading…</p></div>
    <noscript><p class="sec-lede">Events need JavaScript to load. Email <a href="mailto:info@brimwoodinnovation.com">info@brimwoodinnovation.com</a> and we will send you the upcoming dates.</p></noscript>
  </section>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_BASE || '';
    (async () => {
      const el = document.getElementById('eventsList');
      try {
        const r = await fetch(API_BASE + '/api/events', { headers: { accept: 'application/json' } });
        const d = await r.json().catch(() => ({}));
        const events = (d.ok && d.events) || [];
        if (!events.length) {
          el.innerHTML = '<p class="sec-lede">No upcoming events yet. Check back soon.</p>';
          return;
        }
        const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        const fmt = (iso) => new Date(iso).toLocaleString('en-CA', {
          timeZone: 'America/Toronto',
          weekday: 'short', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
        });
        el.className = 'cards cards-3';
        el.innerHTML = events.map((e) => {
          const going = e.rsvp_count || 0;
          const full = e.capacity && going >= e.capacity;
          const seats = e.capacity ? going + ' going · ' + e.capacity + ' seats' : going + ' going';
          return `
          <article class="card">
            <div class="n">${esc(fmt(e.starts_at))}</div>
            <h3><a href="/events/${esc(e.slug)}" style="color:inherit;">${esc(e.title)}</a></h3>
            <p>${esc(seats)}${full ? ' <span class="full-badge">Full</span>' : ''}</p>
            <p style="margin-top:16px;"><a class="btn small" href="/events/${esc(e.slug)}">View event</a></p>
          </article>`;
        }).join('');
      } catch {
        el.innerHTML = '<p class="sec-lede">Could not load events. Please try again later.</p>';
      }
    })();
  </script>
</Base>
