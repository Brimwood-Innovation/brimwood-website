---
/* Events index: upcoming demo nights and gatherings.
 * Client-rendered so new events appear without a rebuild. */
import Base from "../layouts/Base.astro";
---

<Base
  title="Events — Brimwood Innovation"
  description="Demo nights and gatherings at Brimwood Innovation. Builders showing real work, every Friday."
  path="/events"
>
  <section class="block">
    <div class="kicker">Events</div>
    <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">Demo nights and gatherings.</h1>
    <p class="sec-lede">
      Every Friday, builders show real work. No slides about ideas —
      working demos, honest feedback, good people.
    </p>
  </section>

  <section class="block">
    <div id="eventsList"><p class="sec-lede">Loading…</p></div>
  </section>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_BASE || '';
    (async () => {
      const el = document.getElementById('eventsList');
      try {
        const r = await fetch(API_BASE + '/api/events', { headers: { accept: 'application/json' } });
        const d = await r.json().catch(() => ({}));
        const events = (d.ok && d.events) || [];
        if (!events.length) {
          el.innerHTML = '<p class="sec-lede">No upcoming events yet — check back soon.</p>';
          return;
        }
        const esc = (s) => String(s || '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        const fmt = (iso) => new Date(iso).toLocaleDateString('en-CA', {
          weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit'
        });
        el.innerHTML = events.map((e) => `
          <div class="admin-card" style="margin-bottom:16px;">
            <div class="kicker" style="margin-bottom:8px;">${esc(fmt(e.starts_at))}${e.location ? ' · ' + esc(e.location) : ''}</div>
            <h2 class="sec" style="font-size:24px;margin-bottom:8px;">
              <a href="/events/${esc(e.slug)}" style="color:inherit;">${esc(e.title)}</a>
            </h2>
            <p class="admin-muted">${e.rsvp_count || 0} going${e.capacity ? ' · ' + e.capacity + ' spots' : ''}</p>
            <p style="margin-top:12px;"><a class="btn small" href="/events/${esc(e.slug)}">Details and RSVP</a></p>
          </div>`).join('');
      } catch {
        el.innerHTML = '<p class="sec-lede">Could not load events. Please try again later.</p>';
      }
    })();
  </script>
</Base>
