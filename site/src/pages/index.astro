---
/* Home (Phase 2): public sections rebuilt from prototype section 05
 * (v5 UX deck). Vanilla JS only.
 * Site integration: hero copy from CMS settings.json; section visibility
 * from homepage.json enabled flags. The introduction form keeps its
 * fields, submit target, honeypot, and lazy Turnstile exactly as before. */
import Base from "../layouts/Base.astro";
import HeroDots from "../components/HeroDots.astro";
import siteSettings from "../content/settings.json";
import homepage from "../content/homepage.json";

const heroHeadline = siteSettings.hero_headline || "Build a business. Build yourself.";
const heroSubtext = siteSettings.hero_subtext || "";
const ctaText = siteSettings.cta_text || "Request an introduction";
const ctaLink = siteSettings.cta_link || "#introduce";
const sectionOn = (type: string) =>
  (homepage.sections || []).some((s: any) => s.type === type && s.enabled);
const showLoop = sectionOn("features");
const showCta = sectionOn("cta");
// Split hero headline on ". " for the two-line display treatment; the
// closing line takes the prototype's italic accent.
const heroLines = heroHeadline.split(/\.\s*/).filter(Boolean);
---

<Base
  title="Brimwood Innovation — Build a business. Build yourself."
  description="Brimwood Innovation is a calm builder community and hub at 1365 Gerrard St E, Toronto. Work side by side, show your work at demo nights, learn in the Academy."
  path="/"
  turnstile
>
  <div class="hero">
    <HeroDots />
    <img class="lockup" src="/img/brimwood-logo-reversed.svg" alt="Brimwood Innovation logo" />
    <h1>{heroLines.map((line, i) => i === heroLines.length - 1 && heroLines.length > 1
      ? <em>{line}.</em>
      : <>{line}.{i < heroLines.length - 1 && <br />}</>)}</h1>
    <p class="lede">
      {heroSubtext}
    </p>
    <a class="btn" href={ctaLink}>{ctaText}</a>
  </div>

  <div class="facts-strip">
    <ul class="facts" aria-label="Facts">
      <li><b>1365 Gerrard St E</b><span>Toronto, second floor</span></li>
      <li><b>Demo nights</b><span>Wednesdays, 6:30 p.m.</span></li>
      <li><b>Membership is free</b><span>By invitation</span></li>
      <li><b>Anonymous by default</b><span>We share the what, never the who</span></li>
    </ul>
  </div>

  <div class="belief">
    <p>Elite by effort, not by background.</p>
  </div>

  {showLoop && (
  <section class="block">
    <h2 class="sec">How the hub works</h2>
    <p class="sec-lede">One loop, every week.</p>
    <div class="cards cards-3">
      <div class="card"><h3>Build</h3><p>Work sessions at the hub, side by side.</p></div>
      <div class="card"><h3>Show</h3><p>Five-minute demos. Written feedback, no scores.</p></div>
      <div class="card"><h3>Learn</h3><p>Foundations: 3 modules, 9 lessons.</p></div>
    </div>
  </section>
  )}

  <section class="block">
    <div class="next-panel">
      <div>
        <h2>Next at Brimwood</h2>
        <p id="nextEventLine">Demo nights run Wednesdays at 6:30 p.m. at 1365 Gerrard St E.</p>
      </div>
      <a class="btn small" id="nextEventLink" href="/events">See upcoming events</a>
    </div>
  </section>

  {showCta && (
  <section class="block home-intro" id="introduce">
    <h2 class="sec">Request an introduction</h2>
    <p class="sec-lede">Membership is free and by invitation. We read every request and reply within 5 days.</p>
    <div class="intro-card">
      <form class="intro" id="introForm">
        <label for="fName">Your name</label>
        <input id="fName" type="text" name="name" autocomplete="name" placeholder="Jane Appleseed" required />
        <label for="fEmail">Email</label>
        <input id="fEmail" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
        <label for="fRef">Who referred you? <span style="text-transform:none;letter-spacing:0">(optional)</span></label>
        <input id="fRef" type="text" name="referral" placeholder="A member's name, or how you heard of us" />
        <label for="fMsg">What are you building?</label>
        <textarea id="fMsg" name="message" rows="3" aria-describedby="fMsgHint"></textarea>
        <p class="field-hint" id="fMsgHint">Tell us in one line. For example: a booking tool for small clinics.</p>
        <input type="text" name="website" id="fSite" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
        <div class="cf-turnstile" data-sitekey="0x4AAAAAAFLpQ6bCYUs0w0Lx" style="margin:16px 0;"></div>
        <button class="btn btn-primary" type="submit">Send request</button>
        <p class="form-err" id="formErr" role="status" style="display:none">Something went wrong on our end. Please email <a href="mailto:info@brimwoodinnovation.com" style="color:inherit;text-decoration:underline">info@brimwoodinnovation.com</a> directly and we will take it from there.</p>
      </form>
      <div class="thanks" id="thanksMsg" role="status">
        <span class="sent-badge">Sent</span>
        <h3 id="thanksName">Thanks.</h3>
        <p>We read every request and reply within 5 days. If we invite you, the email holds your invite link. Nothing else goes to your inbox.</p>
      </div>
    </div>
  </section>
  )}

  <script>

const API_BASE = import.meta.env.PUBLIC_API_BASE || '';

// --- next event (progressive enhancement; the standing line stays if
// the API has nothing upcoming or cannot be reached) ---
(async () => {
  const line = document.getElementById('nextEventLine');
  const link = document.getElementById('nextEventLink');
  if (!line || !link) return;
  try {
    const r = await fetch(API_BASE + '/api/events', { headers: { accept: 'application/json' } });
    const d = await r.json().catch(() => ({}));
    const ev = d.ok && d.events && d.events[0];
    if (!ev) return;
    const when = new Date(ev.starts_at);
    const date = when.toLocaleDateString('en-CA', { timeZone: 'America/Toronto', weekday: 'short', month: 'short', day: 'numeric' });
    const time = when.toLocaleTimeString('en-CA', { timeZone: 'America/Toronto', hour: 'numeric', minute: '2-digit' });
    line.textContent = [ev.title, date + ', ' + time, ev.location].filter(Boolean).join(' · ');
    if (ev.slug) { link.href = '/events/' + ev.slug; link.textContent = 'Event details'; }
  } catch {}
})();

// --- introduction form (POSTs to /api/introduction; Worker sends via Resend) ---
document.getElementById('introForm').addEventListener('submit', async function(e){
  e.preventDefault();
  const v = id => document.getElementById(id).value.trim();
  const btn = this.querySelector('button[type=submit]');
  const btnLabel = btn.textContent; // restore exactly what the page rendered
  const err = document.getElementById('formErr');
  err.style.display = 'none';
  btn.disabled = true;
  btn.textContent = 'Sending\u2026';
  const showThanks = () => {
    const first = v('fName').split(/\s+/)[0];
    document.getElementById('thanksName').textContent = first ? 'Thanks, ' + first + '.' : 'Thanks.';
    document.getElementById('introForm').style.display = 'none';
    document.getElementById('thanksMsg').style.display = 'block';
  };
  try {
    if (v('fSite')){ // honeypot filled: bot, silently accept, send nothing
      showThanks();
      return;
    }
    const res = await fetch(API_BASE + '/api/introduction', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'accept': 'application/json' },
      body: JSON.stringify({
        name: v('fName'), email: v('fEmail'),
        referral: v('fRef'), message: v('fMsg'),
        website: '',
        'cf-turnstile-response': (document.querySelector('[name="cf-turnstile-response"]') || {}).value || ''
      })
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.ok) throw new Error(data.error || 'send failed');
    showThanks();
  } catch (ex) {
    btn.disabled = false;
    btn.textContent = btnLabel;
    err.style.display = 'block';
  }
});

  </script>
</Base>
