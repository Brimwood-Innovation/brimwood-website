---
/* Home (redesign T10, spec 4.5): repositioned as the agency front
 * door on the lean public shell (T8). Structure, in the approved
 * prototype v3 order: agency hero with the swarm and the three-fact
 * strip, lead services spotlight, pillar preview, how an engagement
 * works, hub band, why Brimwood, the introduction form, and the
 * final CTA. Every service named on this page renders from the T7
 * services collection through the T9 helpers, so the home page can
 * never drift from the services index (review finding P1-1: the
 * pillar preview lists every public service by name under its
 * pillar, with true counts, and no board-only names).
 *
 * Content model: hero copy comes from settings.json and the section
 * headings from homepage.json, as before; both files were updated
 * to the agency wording in this task. The introduction form keeps
 * its fields, submit target, honeypot, and lazy Turnstile exactly
 * as before (the service variant of the form is T11).
 *
 * Member journeys: the home page no longer carries the member shell
 * or its chrome (that is the public shell split, F3). Members reach
 * the hub at /hub, which keeps Base.astro and its chrome unchanged.
 * The old home's member-facing pieces were placed as follows: the
 * four-fact community strip is replaced by the spec 4.5 three-fact
 * strip in the hero; "How the hub works" is replaced by the
 * engagement steps, with the hub story kept as the hub band; the
 * belief line ("Elite by effort, not by background.") is kept as
 * the standard line under Why Brimwood; the Next at Brimwood panel
 * is kept under the hub band with its events fetch, so demo nights
 * stay visible from the front door. */
import Public from "../layouts/Public.astro";
import HeroDots from "../components/HeroDots.astro";
import ServiceCard from "../components/ServiceCard.astro";
import RevealMotion from "../components/RevealMotion.astro";
import siteSettings from "../content/settings.json";
import homepage from "../content/homepage.json";
import { getCollection } from "astro:content";
import { PILLARS, groupByTier, serviceSlug } from "../lib/services";

const heroHeadline =
  siteSettings.hero_headline || "We build the technology your business runs on.";
const heroSubtext = siteSettings.hero_subtext || "";
const ctaText = siteSettings.cta_text || "Request an introduction";
const ctaLink = siteSettings.cta_link || "#introduce";
const section = (type: string) =>
  (homepage.sections || []).find((s: any) => s.type === type);
const sectionOn = (type: string) => {
  const s = section(type);
  return !!s && !!s.enabled;
};
const heading = (type: string, fallback: string) =>
  (section(type) || {}).heading || fallback;
const subheading = (type: string, fallback: string) =>
  (section(type) || {}).subheading || fallback;
const showLead = sectionOn("lead");
const showPillars = sectionOn("pillars");
const showSteps = sectionOn("steps");
const showHub = sectionOn("hub");
const showWhy = sectionOn("why");
const showCta = sectionOn("cta");

/* The closing words of the hero headline take the prototype's
 * Signal Green underline accent (a highlight, never behind text). */
const accent = "runs on.";
const heroHasAccent = heroHeadline.endsWith(accent);
const heroLead = heroHasAccent
  ? heroHeadline.slice(0, -accent.length)
  : heroHeadline;

const services = await getCollection("services");
const leads = services
  .filter((s) => s.data.lead)
  .sort((a, b) => (a.data.pillar === "automate" ? 0 : 1) - (b.data.pillar === "automate" ? 0 : 1));
const byPillar = PILLARS.map((pillar) => ({
  pillar,
  entries: groupByTier(
    services.filter((s) => s.data.pillar === pillar.slug),
  ).flatMap((tier) => tier.entries),
}));

const engagementSteps = [
  {
    title: "Start with a conversation",
    text: "Every engagement starts with an introduction and a conversation about the problem: what is slow, what is manual, what is missing.",
  },
  {
    title: "Scope and price in writing",
    text: "Scope and price are agreed in writing, in an engagement letter, before work starts. Prices are set per engagement, because the work is custom.",
  },
  {
    title: "Built in stages",
    text: "The work is designed and built in stages you can follow, with progress you can see rather than status reports you have to trust.",
  },
  {
    title: "Your approval at each gate",
    text: "Nothing moves to the next stage without your approval at the stage gate. If it is not right, it does not ship.",
  },
];

const whyPoints = [
  {
    title: "A small, senior team",
    text: "You work with the people who do the work. No hand-offs down a chain.",
  },
  {
    title: "Engineered for speed",
    text: "Lightweight builds that load fast, stay fast, and are made to be found.",
  },
  {
    title: "Staged delivery",
    text: "Work arrives in stages, with your approval at each gate before the next begins.",
  },
  {
    title: "No hype",
    text: "Straight claims, honest timelines, and a written scope before anything starts.",
  },
];
---

<Public
  title="Brimwood Innovation - Build a business. Build yourself."
  description="Brimwood Innovation is a Toronto agency and builder hub: custom automation, websites with lead engines, and custom software for businesses, built at 1365 Gerrard St E, Unit 2, Toronto."
  path="/"
  turnstile
>
  <div class="hero home-hero">
    <HeroDots />
    <p class="eyebrow">Brimwood Innovation - Agency - Toronto</p>
    <h1>{heroLead}{heroHasAccent && <span class="hero-accent">{accent}</span>}</h1>
    <p class="lede">{heroSubtext}</p>
    <div class="hero-ctas">
      <a class="btn" href={ctaLink}>{ctaText}</a>
      <a class="btn btn-ghost-dark" href="/services/">See the services</a>
    </div>
    <div class="hero-facts">
      <div class="hero-fact">
        <b>1365 Gerrard St E</b>
        <span>A working hub in Toronto, Unit 2</span>
      </div>
      <div class="hero-fact">
        <b>Starts with a conversation</b>
        <span>Every engagement, no checkout page</span>
      </div>
      <div class="hero-fact">
        <b>Agreed in writing first</b>
        <span>Scope and price settled before work starts</span>
      </div>
    </div>
  </div>

  {showLead && (
  <section class="block home-ui">
    <div class="kicker">Lead services</div>
    <h2 class="sec">{heading("lead", "The two services most clients need first.")}</h2>
    <p class="sec-lede">{subheading("lead", "")}</p>
    <div class="cards cards-2" data-reveal-group>
      {leads.map((entry) => <ServiceCard entry={entry} headingLevel="h3" />)}
    </div>
  </section>
  )}

  {showPillars && (
  <section class="block home-ui">
    <div class="kicker">All services</div>
    <h2 class="sec">{heading("pillars", "Five pillars. Seventeen services.")}</h2>
    <p class="sec-lede">{subheading("pillars", "")} <a href="/services/">Open the full services index</a>.</p>
    <div class="cards cards-3" data-reveal-group>
      {byPillar.map(({ pillar, entries }) => (
        <article class="card pillar-card" data-reveal>
          <h3 class="card-title"><a href={`/services/${pillar.slug}/`}>{pillar.name}</a></h3>
          <p class="pillar-lede">{pillar.lede}</p>
          <p class="pillar-count">{entries.length} services</p>
          <ul class="pillar-list">
            {entries.map((entry) => (
              <li><a href={`/services/${entry.data.pillar}/${serviceSlug(entry.id)}/`}>{entry.data.name}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
  )}

  {showSteps && (
  <section class="block home-ui">
    <div class="kicker">How it works</div>
    <h2 class="sec">{heading("steps", "How an engagement works.")}</h2>
    <p class="sec-lede">{subheading("steps", "")}</p>
    <div class="steps steps-4" data-reveal-group>
      {engagementSteps.map((step, i) => (
        <article class="step" data-reveal>
          <div class="num" aria-hidden="true">{i + 1}</div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>
  )}

  {showHub && (
  <section class="block home-ui">
    <div class="hub-band" data-reveal>
      <div>
        <div class="kicker kicker-light">The hub</div>
        <h2>{heading("hub", "An agency inside a working builder hub.")}</h2>
        <p>{subheading("hub", "")}</p>
        <div class="hub-rhythm">
          <span>Mon: Commit</span>
          <span>Wed: Forge</span>
          <span>Fri: Demo</span>
        </div>
      </div>
      <div class="hub-quote">
        <p class="hub-quote-core">&ldquo;Build a business. Build yourself.&rdquo;</p>
        <p>The hub&rsquo;s core idea, and the standard the agency works to: the people who build for you are building themselves, too.</p>
      </div>
    </div>
    <div class="next-panel home-next">
      <div>
        <h2>Next at Brimwood</h2>
        <p id="nextEventLine">Demo nights run Wednesdays at 6:30 p.m. at 1365 Gerrard St E.</p>
      </div>
      <a class="btn small" id="nextEventLink" href="/events">See upcoming events</a>
    </div>
  </section>
  )}

  {showWhy && (
  <section class="block home-ui">
    <div class="kicker">Why Brimwood</div>
    <h2 class="sec">{heading("why", "Small team. Written scope. Work that loads fast.")}</h2>
    <div class="why-grid" data-reveal-group>
      {whyPoints.map((point) => (
        <article class="why" data-reveal>
          <h3>{point.title}</h3>
          <p>{point.text}</p>
        </article>
      ))}
    </div>
    <p class="standard">Our standard: <em>Elite by effort, not by background.</em></p>
  </section>
  )}

  {showCta && (
  <section class="block home-intro" id="introduce">
    <h2 class="sec">{heading("cta", "Request an introduction")}</h2>
    <p class="sec-lede">{subheading("cta", "")}</p>
    <div class="intro-card">
      <form class="intro" id="introForm">
        <label for="fName">Your name</label>
        <input id="fName" type="text" name="name" autocomplete="name" placeholder="Jane Appleseed" required />
        <label for="fEmail">Email</label>
        <input id="fEmail" type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
        <label for="fRef">Who referred you? <span class="label-note">(optional)</span></label>
        <input id="fRef" type="text" name="referral" placeholder="A member's name, or how you heard of us" />
        <label for="fMsg">What are you building?</label>
        <textarea id="fMsg" name="message" rows="3" aria-describedby="fMsgHint"></textarea>
        <p class="field-hint" id="fMsgHint">Tell us in one line. For example: a booking tool for small clinics.</p>
        <input type="text" name="website" id="fSite" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
        <div class="cf-turnstile turnstile-box" data-sitekey="0x4AAAAAAFLpQ6bCYUs0w0Lx"></div>
        <button class="btn btn-primary" type="submit">Send request</button>
        <p class="form-err is-hidden" id="formErr" role="status">Something went wrong on our end. Please email <a href="mailto:info@brimwoodinnovation.com">info@brimwoodinnovation.com</a> directly and we will take it from there.</p>
      </form>
      <div class="thanks" id="thanksMsg" role="status">
        <span class="sent-badge">Sent</span>
        <h3 id="thanksName">Thanks.</h3>
        <p>We read every request and reply within 5 days. If we invite you, the email holds your invite link. Nothing else goes to your inbox.</p>
      </div>
    </div>
  </section>

  <section class="block home-ui">
    <div class="cta" data-reveal>
      <h2>Start with an introduction.</h2>
      <p>Tell us the problem. We will tell you plainly whether we are the right team to build the fix, and what it would take.</p>
      <a class="btn" href={ctaLink}>{ctaText}</a>
    </div>
  </section>
  )}

  <RevealMotion />

  <script>

const API_BASE = import.meta.env.PUBLIC_API_BASE || '';

// --- next event (progressive enhancement; the standing line stays if
// the API has nothing upcoming or cannot be reached) ---
(async () => {
  const line = document.getElementById('nextEventLine');
  const link = document.getElementById('nextEventLink');
  if (!line || !link) return;
  try {
    const r = await fetch(API_BASE + '/api/events', { headers: { accept: 'application/json' } });
    const d = await r.json().catch(() => ({}));
    const ev = d.ok && d.events && d.events[0];
    if (!ev) return;
    const when = new Date(ev.starts_at);
    const date = when.toLocaleDateString('en-CA', { timeZone: 'America/Toronto', weekday: 'short', month: 'short', day: 'numeric' });
    const time = when.toLocaleTimeString('en-CA', { timeZone: 'America/Toronto', hour: 'numeric', minute: '2-digit' });
    line.textContent = [ev.title, date + ', ' + time, ev.location].filter(Boolean).join(' · ');
    if (ev.slug) { link.href = '/events/' + ev.slug; link.textContent = 'Event details'; }
  } catch {}
})();

// --- introduction form (POSTs to /api/introduction; Worker sends via Resend) ---
const introFormEl = document.getElementById('introForm');
if (introFormEl) introFormEl.addEventListener('submit', async function(e){
  e.preventDefault();
  const v = id => document.getElementById(id).value.trim();
  const btn = this.querySelector('button[type=submit]');
  const btnLabel = btn.textContent; // restore exactly what the page rendered
  const err = document.getElementById('formErr');
  err.style.display = 'none';
  btn.disabled = true;
  btn.textContent = 'Sending\u2026';
  const showThanks = () => {
    const first = v('fName').split(/\s+/)[0];
    document.getElementById('thanksName').textContent = first ? 'Thanks, ' + first + '.' : 'Thanks.';
    document.getElementById('introForm').style.display = 'none';
    document.getElementById('thanksMsg').style.display = 'block';
  };
  try {
    if (v('fSite')){ // honeypot filled: bot, silently accept, send nothing
      showThanks();
      return;
    }
    const res = await fetch(API_BASE + '/api/introduction', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'accept': 'application/json' },
      body: JSON.stringify({
        name: v('fName'), email: v('fEmail'),
        referral: v('fRef'), message: v('fMsg'),
        website: '',
        'cf-turnstile-response': (document.querySelector('[name="cf-turnstile-response"]') || {}).value || ''
      })
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok || !data.ok) throw new Error(data.error || 'send failed');
    showThanks();
  } catch (ex) {
    btn.disabled = false;
    btn.textContent = btnLabel;
    err.style.display = 'block';
  }
});

  </script>
</Public>
