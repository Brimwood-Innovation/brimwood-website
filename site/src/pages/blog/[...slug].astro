---
/* Article page (T10): title, pillar, date, body, author. */
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const slug = post.id.replace(/\.md$/, "");
const apiBase = import.meta.env.PUBLIC_API_BASE || "";
const { Content } = await render(post);

const pillars: Record<string, string> = {
  "micro-business": "Micro business",
  "ai-in-practice": "AI in practice",
  "owner-mindset": "Owner mindset",
  "members-hub": "Members + hub",
};
---

<Base
  title={`${post.data.title} — Brimwood Innovation`}
  description={post.data.description}
  path={`/blog/${slug}`}
  turnstile
>
  <article class="prose">
    <div class="kicker">{pillars[post.data.pillar]}{post.data.draft ? " · DRAFT" : ""}</div>
    <h1>{post.data.title}</h1>
    <p class="sec-lede">
      {post.data.publishDate.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric" })}
      {" · "}{post.data.author}
      {post.data.tags.length > 0 && <>{" · "}{post.data.tags.join(", ")}</>}
    </p>
    <Content />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.description,
        datePublished: post.data.publishDate.toISOString(),
        author: { "@type": "Organization", name: "Brimwood Innovation" },
        publisher: {
          "@type": "Organization",
          name: "Brimwood Innovation",
          logo: { "@type": "ImageObject", url: "https://brimwoodinnovation.com/img/brimwood-logo-colour.svg" },
        },
        mainEntityOfPage: `https://brimwoodinnovation.com/blog/${slug}/`,
      })}
    </script>
    <p style="margin-top:3rem;">
      <a class="btn btn-ghost" href="/blog">All posts</a>
    </p>
  </article>

  <section id="comments" style="margin-top:4rem;max-width:720px;" data-slug={slug} data-api-base={apiBase}>
    <h2 class="sec" style="font-size:clamp(22px,3vw,30px);margin-bottom:8px;">Comments</h2>
    <div id="commentList"><p class="sec-lede">Loading comments…</p></div>

    <div class="cta" style="margin-top:2rem;">
      <h3 style="margin-bottom:8px;">Join the conversation</h3>
      <p style="margin-bottom:16px;">Comments are moderated — be kind and on topic.</p>
      <form id="commentForm">
        <label for="cName">Your name</label>
        <input id="cName" type="text" name="name" placeholder="Jane Appleseed" required />
        <label for="cEmail">Email <span style="font-weight:400;">(never published)</span></label>
        <input id="cEmail" type="email" name="email" placeholder="you@example.com" required />
        <label for="cBody">Comment</label>
        <textarea id="cBody" name="body" rows="4" placeholder="Share your thoughts…" required minlength="10" maxlength="2000"></textarea>
        <div class="cf-turnstile" data-sitekey="0x4AAAAAAFLpQ6bCYUs0w0Lx" style="margin:16px 0;"></div>
        <button class="btn" type="submit" id="commentBtn">Post comment</button>
        <p class="form-err" id="commentErr" style="display:none;"></p>
      </form>
      <div class="thanks" id="commentThanks">Thanks — your comment is awaiting moderation.</div>
    </div>
  </section>

  <script is:inline src="/js/blog-comments.js"></script>
</Base>
