---
/* Certificate check (Phase 4 slice 1, SPEC D3, deck /c/CODE).
 * Static-first site, so the code is never known at build time: the
 * _redirects rewrite serves this page for /c/CODE while the browser
 * keeps the /c/CODE URL, and this page reads the code from the path
 * (or from ?code= when opened locally) and checks it against
 * /api/certificates/verify. The shell is noindex: a static shell cannot
 * know at build time whether the code is public. Once verify answers
 * valid with visibility public, the script upgrades the head in place
 * (title, description, canonical, robots index, Open Graph, and
 * credential JSON-LD) so a rendering crawler sees a per-code head for
 * that public certificate. Every other answer leaves the shell
 * noindex: link visibility is shared by link, not listed publicly, so
 * it never upgrades the head. The sitemap listing of public codes is
 * the remaining indexing step.
 *
 * States, exactly as the API answers them: valid (public or link) shows
 * the holder's current display name, the course, and the issue date;
 * private shows only that the holder has not shared it; revoked,
 * superseded, and withdrawn show that the certificate is no longer
 * valid and when that changed; anything else shows that no certificate
 * matches the code. Email, lessons, reflections, and cohort peers
 * never appear here. All rendered values are escaped.
 */
import Base from "../../layouts/Base.astro";
---

<Base
  title="Check a certificate - Brimwood Innovation"
  description="Check a Brimwood Innovation certificate by its code."
  path="/c/check"
  noindex
>
  <section class="block" id="cert-loading">
    <div class="kicker">Certificate check</div>
    <p class="sec-lede">Checking the certificate…</p>
  </section>

  <section class="block" id="cert-result" style="display:none;max-width:720px;">
    <div class="kicker">Certificate check</div>
    <div id="cert-card" role="status"></div>
    <form id="cert-again" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:24px;">
      <label style="flex:1;min-width:220px;">Check another certificate
        <input id="cert-input" type="text" inputmode="text" autocomplete="off" placeholder="BRIM-2026-XXXXXX" aria-label="Check another certificate" style="width:100%;" />
      </label>
      <button type="submit" class="btn btn-primary" style="align-self:end;">Check</button>
    </form>
  </section>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_BASE || "";
    const esc = (s) => String(s ?? "").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const $ = (id) => document.getElementById(id);
    const codeFromUrl = () => {
      const q = new URLSearchParams(window.location.search).get("code");
      if (q) return q.trim().toUpperCase();
      const seg = window.location.pathname.split("/").filter(Boolean).pop() || "";
      return seg.toUpperCase();
    };
    const fmtDate = (iso) => {
      try {
        return new Date(iso).toLocaleDateString("en-CA", { year: "numeric", month: "short", day: "numeric" });
      } catch { return ""; }
    };
    /* Per-code head for a public certificate only. All values come from
     * the verified API answer and are assigned as text or attributes,
     * never as HTML, so a display name cannot inject markup into the
     * head. Link, private, revoked, and not-found answers never reach
     * this function, so their pages stay on the noindex shell. */
    const setMeta = (attr, name, value) => {
      let el = document.querySelector(`meta[${attr}="${name}"]`);
      if (!el) {
        el = document.createElement("meta");
        el.setAttribute(attr, name);
        document.head.appendChild(el);
      }
      el.setAttribute("content", value);
    };
    const setPublicHead = (d) => {
      const issued = fmtDate(d.issued_at);
      const url = `https://brimwoodinnovation.com/c/${d.code}`;
      const title = `${d.display_name} - ${d.course_title} certificate - Brimwood Innovation`;
      const description = issued
        ? `${d.display_name} earned the ${d.course_title} certificate from Brimwood Innovation, issued ${issued}.`
        : `${d.display_name} earned the ${d.course_title} certificate from Brimwood Innovation.`;
      document.title = title;
      setMeta("name", "description", description);
      setMeta("name", "robots", "index, follow");
      const canonical = document.querySelector('link[rel="canonical"]');
      if (canonical) canonical.setAttribute("href", url);
      setMeta("property", "og:title", title);
      setMeta("property", "og:description", description);
      setMeta("property", "og:url", url);
      setMeta("name", "twitter:title", title);
      setMeta("name", "twitter:description", description);
      if (!document.getElementById("cert-jsonld")) {
        const script = document.createElement("script");
        script.id = "cert-jsonld";
        script.type = "application/ld+json";
        script.text = JSON.stringify({
          "@context": "https://schema.org",
          "@type": "EducationalOccupationalCredential",
          name: `${d.course_title} certificate`,
          credentialCategory: "Certificate",
          recognizedBy: { "@type": "Organization", name: "Brimwood Innovation" },
          url,
          identifier: d.code,
        });
        document.head.appendChild(script);
      }
    };

    async function check(code) {
      $("cert-loading").style.display = "none";
      $("cert-result").style.display = "";
      const card = $("cert-card");
      if (!code) {
        card.innerHTML = `<h1 class="sec" style="font-size:clamp(28px,4vw,40px);">No code given.</h1><p class="sec-lede">Enter a certificate code below to check it.</p>`;
        return;
      }
      let d;
      try {
        const r = await fetch(`${API_BASE}/api/certificates/verify?code=${encodeURIComponent(code)}`, { headers: { accept: "application/json" } });
        d = await r.json();
      } catch {
        card.innerHTML = `<h1 class="sec" style="font-size:clamp(28px,4vw,40px);">Check failed.</h1><p class="sec-lede">Please try again in a moment.</p>`;
        return;
      }
      if (d.state === "valid") {
        if (d.visibility === "public") setPublicHead(d);
        const issued = fmtDate(d.issued_at);
        const url = `https://brimwoodinnovation.com/c/${esc(d.code)}`;
        const fields = `Name: ${d.course_title}. Organization: Brimwood Innovation. Issued: ${issued}. Credential ID: ${d.code}. URL: ${url}`;
        card.innerHTML = `<p><span class="badge badge-success">Valid certificate</span></p>
          <h1 class="sec" style="font-size:clamp(28px,4vw,40px);">${esc(d.display_name)}</h1>
          <p class="sec-lede">${esc(d.course_title)} · issued ${esc(issued)}</p>
          <p class="thread-sub">Certificate code <span class="mono">${esc(d.code)}</span>. Signed by Brimwood (Ed25519). Does not expire.</p>
          <p><button type="button" class="btn btn-secondary" id="cert-copy">Copy LinkedIn fields</button></p>`;
        $("cert-copy").addEventListener("click", async () => {
          try { await navigator.clipboard.writeText(fields); $("cert-copy").textContent = "Copied"; } catch {}
        });
      } else if (d.state === "private") {
        card.innerHTML = `<p><span class="badge badge-neutral">Private</span></p>
          <h1 class="sec" style="font-size:clamp(28px,4vw,40px);">This certificate is not public.</h1>
          <p class="sec-lede">The holder has not shared it. If someone sent you this link, ask them to share it from their account.</p>`;
      } else if (d.state === "revoked" || d.state === "superseded" || d.state === "withdrawn") {
        card.innerHTML = `<p><span class="badge badge-danger">No longer valid</span></p>
          <h1 class="sec" style="font-size:clamp(28px,4vw,40px);">This certificate is no longer valid.</h1>
          <p class="sec-lede">Brimwood ${d.state === "revoked" ? "revoked" : d.state} it${d.status_changed_at ? ` on ${esc(fmtDate(d.status_changed_at))}` : ""}. The code stays on record and will never be reused.</p>`;
      } else {
        card.innerHTML = `<h1 class="sec" style="font-size:clamp(28px,4vw,40px);">No certificate matches that code.</h1>
          <p class="sec-lede">Check the code and try again. Codes look like BRIM-2026-XXXXXX.</p>`;
      }
    }

    $("cert-again").addEventListener("submit", (e) => {
      e.preventDefault();
      const code = $("cert-input").value.trim().toUpperCase();
      if (code) window.location.href = `/c/${encodeURIComponent(code)}`;
    });
    check(codeFromUrl());
  </script>
</Base>
