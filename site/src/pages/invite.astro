---
/* Invite redemption (T28): recipient enters name + email + invite code,
 * gets a magic sign-in code emailed to them. */
import Base from "../layouts/Base.astro";
---

<Base
  title="Redeem your invite — Brimwood Innovation"
  description="You have been invited to Brimwood Innovation. Enter your invite code to join."
  path="/invite"
>
  <section class="block" style="text-align:center;max-width:560px;margin-inline:auto;">
    <div class="kicker">You are invited</div>
    <h1 class="sec" style="font-size:clamp(34px,5.4vw,56px);margin-bottom:18px;">Welcome to Brimwood.</h1>
    <p class="sec-lede" style="margin-inline:auto;">
      Someone thinks you belong here. Enter your details and the invite code
      you received — we will email you a sign-in code.
    </p>

    <form id="inviteForm" style="text-align:left;margin-top:32px;">
      <label for="iName">Your name</label>
      <input id="iName" type="text" name="name" placeholder="Jane Appleseed" required
        style="width:100%;padding:12px 16px;border:1px solid rgba(18,26,22,.15);border-radius:12px;font-size:16px;margin-bottom:16px;" />
      <label for="iEmail">Email</label>
      <input id="iEmail" type="email" name="email" placeholder="you@example.com" required
        style="width:100%;padding:12px 16px;border:1px solid rgba(18,26,22,.15);border-radius:12px;font-size:16px;margin-bottom:16px;" />
      <label for="iCode">Invite code</label>
      <input id="iCode" type="text" name="code" placeholder="XXXX-XXXX" required autocomplete="off"
        style="width:100%;padding:12px 16px;border:1px solid rgba(18,26,22,.15);border-radius:12px;font-size:16px;margin-bottom:24px;text-transform:uppercase;" />
      <button class="btn" type="submit" id="inviteBtn" style="width:100%;">Redeem invite</button>
      <p id="inviteErr" role="status" style="display:none;color:#b3261e;margin-top:16px;"></p>
    </form>

    <div id="inviteDone" role="status" style="display:none;margin-top:32px;">
      <div class="kicker" style="color:var(--emerald-deep);">Check your inbox</div>
      <p class="sec-lede" style="margin-inline:auto;">
        Your invite worked. We sent a sign-in code to your email —
        enter it on the <a href="/members">members page</a> to sign in.
      </p>
    </div>
  </section>

  <script>
    const API_BASE = import.meta.env.PUBLIC_API_BASE || '';
    // Pre-fill code from ?code= link.
    const params = new URLSearchParams(location.search);
    const prefill = params.get('code');
    if (prefill) document.getElementById('iCode').value = prefill.toUpperCase();

    document.getElementById('inviteForm').addEventListener('submit', async function(e){
      e.preventDefault();
      const v = id => document.getElementById(id).value.trim();
      const btn = document.getElementById('inviteBtn');
      const err = document.getElementById('inviteErr');
      err.style.display = 'none';
      btn.disabled = true;
      btn.textContent = 'Redeeming…';
      try {
        const res = await fetch(API_BASE + '/api/auth/redeem-invite', {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'accept': 'application/json' },
          body: JSON.stringify({ name: v('iName'), email: v('iEmail'), code: v('iCode') })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'redeem failed');
        document.getElementById('inviteForm').style.display = 'none';
        document.getElementById('inviteDone').style.display = 'block';
      } catch (ex) {
        btn.disabled = false;
        btn.textContent = 'Redeem invite';
        err.textContent = ex.message;
        err.style.display = 'block';
      }
    });
  </script>
</Base>
