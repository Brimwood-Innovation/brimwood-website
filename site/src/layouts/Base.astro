---
/* Base layout (T7): SEO/AEO/GEO head, v7 header + footer.
 * Site integration: header nav, footer, CTA, and announcement bar are
 * driven by the CMS (site/src/content/navigation.json + settings.json).
 * Brand rule enforced: max four header links + one emerald CTA button. */
import "../styles/brand.css";
import siteSettings from "../content/settings.json";
import navigation from "../content/navigation.json";

interface ArticleMeta {
  publishedTime: string;
  author: string;
  tags: string[];
}
interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  /* F7: Turnstile loads only on pages that render a cf-turnstile widget.
   * Pages opt in with <Base turnstile>. Never load it globally. */
  turnstile?: boolean;
  /* og:type override (default "website"); article pages pass "article"
   * together with articleMeta. jsonld renders extra schema in <head>. */
  ogType?: string;
  articleMeta?: ArticleMeta;
  jsonld?: Record<string, unknown>;
  /* audit/social/wiring: canonical override. /u/<id> profile pages pass the
   * /@username URL here so search engines see one canonical profile. */
  canonicalPath?: string;
}
const {
  title,
  description,
  path = "/",
  image,
  turnstile = false,
  ogType = "website",
  articleMeta,
  jsonld,
  canonicalPath,
} = Astro.props;
const canonical = `https://brimwoodinnovation.com${canonicalPath || path}`;
const ogImage = image || "https://brimwoodinnovation.com/img/brimwood-og.png";
// Brand rule: logo left, four links, one emerald button. Extra CMS links
// are ignored so the CMS can never break the nav structure.
const headerLinks = (navigation.header_links || []).slice(0, 4);
const footerLinks = navigation.footer_links || [];
const ctaText = siteSettings.cta_text || "Request an introduction";
const ctaLink = siteSettings.cta_link || "#introduce";
const announcement = (siteSettings.announcement_bar || "").trim();
const siteTitle = siteSettings.site_title || "Brimwood Innovation";
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0C9463" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brimwood Innovation — Build a business. Build yourself." />
    <meta property="og:locale" content="en_CA" />
    {ogType === "article" && articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:author" content={articleMeta.author} />
        {articleMeta.tags.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Brimwood Innovation — Build a business. Build yourself." />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      href="/fonts/plus-jakarta-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* set:html — expressions are not evaluated inside <script> bodies. */}
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: siteTitle,
        url: "https://brimwoodinnovation.com",
        logo: "https://brimwoodinnovation.com/img/brimwood-logo-colour.svg",
        slogan: "Build a business. Build yourself.",
        address: {
          "@type": "PostalAddress",
          addressLocality: "Toronto",
          addressRegion: "ON",
          addressCountry: "CA",
        },
      })} />
    {jsonld && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    )}
    {turnstile && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site">
      <a href="/" aria-label="Brimwood Innovation home">
        <img class="logo" src="/img/brimwood-logo-colour.svg" alt="Brimwood Innovation" />
      </a>
      <nav aria-label="Primary" class="main-nav">
        {headerLinks.map((l) => <a href={l.url}>{l.label}</a>)}
        <span style="position:relative;display:inline-flex;">
          <button id="notifBell" aria-label="Notifications" aria-expanded="false" aria-haspopup="true"
            style="display:none;background:none;border:none;cursor:pointer;padding:6px;position:relative;color:inherit;">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            <span id="notifBadge" style="display:none;position:absolute;top:0;right:0;min-width:18px;height:18px;padding:0 4px;border-radius:9px;background:#0C9463;color:#fff;font-size:11px;font-weight:700;align-items:center;justify-content:center;">0</span>
          </button>
          <div id="notifPanel" role="dialog" aria-label="Notifications" style="display:none;position:absolute;right:0;top:calc(100% + 8px);width:min(92vw,380px);max-height:70vh;overflow:auto;background:#fff;border:1px solid #e5eae7;border-radius:16px;box-shadow:0 16px 40px rgba(0,0,0,.16);z-index:1000;">
            <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 16px 8px;">
              <strong style="color:#121A16;">Notifications</strong>
              <span><button id="notifMarkAll" style="display:none;background:none;border:none;color:#0C9463;font-size:13px;cursor:pointer;margin-right:8px;">Mark all read</button><a href="/notifications" style="font-size:13px;color:#0C9463;">View all</a></span>
            </div>
            <div id="notifList"></div>
          </div>
        </span>
        <a href="/search" aria-label="Search the site" style="display:inline-flex;align-items:center;">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
        </a>
        <a class="btn small" href={ctaLink}>{ctaText}</a>
      </nav>
    </header>
    {announcement && (
      <div class="announcement-bar" role="note">
        {announcement}
      </div>
    )}
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="foot-inner">
        <div class="foot-top">
          <img src="/img/brimwood-logo-reversed.svg" alt="Brimwood Innovation" />
          <div class="foot-links">
            {footerLinks.map((l) => (
              <a href={l.url} id={l.url === "/members" ? "footMember" : undefined}>{l.label}</a>
            ))}
            <a href="/admin" id="footAdmin" style="display:none;">Admin</a>
          </div>
          <div class="foot-links">
            <a href="https://instagram.com/brimwoodinnovation" target="_blank" rel="noopener">Instagram</a>
            <a href="https://www.threads.com/@brimwoodinnovation" target="_blank" rel="noopener">Threads</a>
            <a href="https://facebook.com/brimwoodinnovation" target="_blank" rel="noopener">Facebook</a>
            <a href="https://x.com/brimwoodai" target="_blank" rel="noopener">X</a>
            <a href="https://www.linkedin.com/in/brimwoodinnovation/" target="_blank" rel="noopener">LinkedIn</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>&copy; 2026 {siteTitle}</span>
          <span>1365 Gerrard St E Unit 2, Toronto</span>
        </div>
      </div>
    </footer>
    <script>
      // Footer member links reflect auth state.
      (async () => {
        try {
          const apiBase = import.meta.env.PUBLIC_API_BASE || "";
          const r = await fetch(apiBase + "/api/auth/me", {
            headers: { accept: "application/json" },
            credentials: "include",
          });
          const d = await r.json().catch(() => ({}));
          if (r.ok && d.ok) {
            const fm = document.getElementById("footMember");
            if (fm) { fm.textContent = "Dashboard"; fm.href = "/dashboard"; }
            if (d.user.role === "admin") {
              const fa = document.getElementById("footAdmin");
              if (fa) fa.style.display = "inline";
            }
          }
        } catch {}
      })();
    </script>
    <script src="/js/profile-url.js" defer></script>
    <script src="/js/mentions.js" defer></script>
    <script src="/js/share-to-dm.js" defer></script>
    <script src="/js/notifications-bell.js" defer></script>
  </body>
</html>
